{
  "name": "SAP-Basis-knowledge-center",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap-cloud-sdk/connectivity": "^4.8.0",
    "@sap-cloud-sdk/http-client": "^4.8.0",
    "@sap/cds": "^10",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3.0.2",
    "@sap/cds-dk": "^10"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "private": true,
  "cds": {
    "server": {
      "body_parser": {
        "limit": "30mb"
      }
    },
    "requires": {
      "[development]": {
        "auth": {
          "kind": "mocked",
          "users": {
            "sami":      { "roles": ["Employee"] },
            "nadia":     { "roles": ["Manager"] },
            "rh":        { "roles": ["HR"] },
            "admin":     { "roles": ["Administrator"] },
            "stagiaire": { "roles": ["Intern"] }
          }
        }
      },
      "[production]": {
        "auth": "xsuaa",
        "db": {
          "kind": "hana"
        }
      }
    }
  }
}
