<mvc:View
  controllerName="aymax.hr.controller.HR"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:layout="sap.ui.layout"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <Page showHeader="false" class="aymaxPage">
    <content>
      <VBox class="sapUiContentPadding aymaxPageContent">

        <!-- ═══════ TAB: EMPLOYES ═══════ -->
        <VBox visible="{= ${view>/activeTab} === 'employes'}">

          <!-- —— Employee List View —— -->
          <VBox visible="{= !${view>/activeEmployeeId}}">
            <Panel class="aymaxCard" headerText="">
              <Table
                id="employeeTable"
                items="{path: '/Employees', parameters: { $expand: 'skills' }}"
                growing="true"
                growingThreshold="10"
                class="aymaxTable"
                mode="SingleSelectMaster"
                selectionChange=".onEmployeePress">
                <columns>
                  <Column width="25%"><Text text="Employé"/></Column>
                  <Column width="20%"><Text text="Département"/></Column>
                  <Column width="15%"><Text text="Niveau"/></Column>
                  <Column width="15%" hAlign="Center"><Text text="Réputation"/></Column>
                  <Column width="25%"><Text text="Objectifs"/></Column>
                </columns>
                <items>
                  <ColumnListItem type="Active" press=".onEmployeePress">
                    <cells>
                      <HBox alignItems="Center">
                        <Avatar initials="{initials}" displaySize="XS" class="sapUiSmallMarginEnd aymaxAvatarAccent"/>
                        <Text text="{name}" class="aymaxEmployeeName"/>
                      </HBox>
                      <Text text="{dept}" class="aymaxMetaText"/>
                      <ObjectStatus text="{level}" state="Information" inverted="true" class="aymaxLevelBadge"/>
                      <ObjectNumber number="{reputation}" class="aymaxRepNumber"/>
                      <ObjectStatus
                        text="{path:'objStatus', formatter:'.formatObjStatusText'}"
                        state="{path:'objStatus', formatter:'.formatObjStatusState'}"
                        inverted="true"
                        class="aymaxStatusBadge"/>
                    </cells>
                  </ColumnListItem>
                </items>
              </Table>
            </Panel>
          </VBox>

          <!-- —— Employee Detail View —— -->
          <VBox id="detailViewBox" visible="{= !!${view>/activeEmployeeId}}" class="aymaxDetailView">

            <Button
              text="← Retour aux employés"
              type="Transparent"
              press=".onBackToList"
              class="sapUiSmallMarginBottom aymaxBackBtn"/>

            <layout:HorizontalLayout allowWrapping="true" class="aymaxDetailLayout">

              <!-- Profile Card -->
              <VBox width="280px" class="sapUiMediumMarginEnd">
                <Panel class="aymaxProfileDetailCard">
                  <VBox alignItems="Center" class="sapUiMediumMargin">
                    <Avatar
                      initials="{initials}"
                      displaySize="XL"
                      class="sapUiSmallMarginBottom aymaxAvatarAccent"/>
                    <Title
                      text="{name}"
                      level="H3"/>
                    <Text
                      text="{dept}"
                      class="aymaxMetaText sapUiTinyMarginBottom"/>
                    <ObjectStatus
                      text="{level}"
                      state="Information"
                      inverted="true"
                      class="sapUiSmallMarginBottom aymaxLevelBadge"/>
                    <VBox alignItems="Center" class="sapUiSmallMarginTop aymaxStatDivider" width="100%">
                      <Title
                        text="{reputation}"
                        level="H2" class="aymaxRepTitle"/>
                      <Text text="Réputation" class="aymaxMetaText"/>
                    </VBox>
                  </VBox>
                </Panel>
              </VBox>

              <!-- Right Detail Cards -->
              <VBox class="aymaxDetailRight">

                <!-- Skills -->
                <Panel class="aymaxCard sapUiSmallMarginBottom">
                  <headerToolbar>
                    <Toolbar style="Clear"><Title level="H5" text="Compétences" class="card-kicker"/></Toolbar>
                  </headerToolbar>
                  <List
                    items="{skills}"
                    showSeparators="None"
                    class="aymaxSkillList">
                    <CustomListItem>
                      <VBox class="sapUiSmallMargin">
                        <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                          <Text text="{name}" class="aymaxSkillName"/>
                          <Text text="{stars}" class="aymaxSkillStars"/>
                        </HBox>
                        <layout:HorizontalLayout class="aymaxProgressBarOuter">
                          <layout:HorizontalLayout
                            class="aymaxProgressBarInner"
                            width="{= ${percent} + '%' }">
                          </layout:HorizontalLayout>
                        </layout:HorizontalLayout>
                      </VBox>
                    </CustomListItem>
                  </List>
                </Panel>

                <!-- Objective -->
                <Panel class="aymaxCard sapUiSmallMarginBottom">
                  <headerToolbar>
                    <Toolbar style="Clear"><Title level="H5" text="Objectifs" class="card-kicker"/></Toolbar>
                  </headerToolbar>
                  <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMargin">
                    <Text
                      text="{objectiveTitle}"
                      class="aymaxObjTitle"/>
                    <ObjectStatus
                      text="{path:'objStatus', formatter:'.formatObjStatusText'}"
                      state="{path:'objStatus', formatter:'.formatObjStatusState'}"
                      inverted="true"
                      class="aymaxStatusBadge"/>
                  </HBox>
                </Panel>

                <!-- Certifications -->
                <Panel class="aymaxCard">
                  <headerToolbar>
                    <Toolbar style="Clear"><Title level="H5" text="Certifications" class="card-kicker"/></Toolbar>
                  </headerToolbar>
                  <HBox class="sapUiSmallMargin" justifyContent="Start">
                    <VBox class="sapUiMediumMarginEnd">
                      <ObjectStatus
                        text="{certsEarnedCount} obtenues"
                        state="Success"
                        inverted="false"/>
                    </VBox>
                    <VBox>
                      <ObjectStatus
                        text="{certsProgressCount} en cours"
                        state="Information"
                        inverted="false"/>
                    </VBox>
                  </HBox>
                </Panel>
              </VBox>
            </layout:HorizontalLayout>
          </VBox>
        </VBox>

        <!-- ═══════ TAB: COMPETENCES ═══════ -->
        <VBox visible="{= ${view>/activeTab} === 'competences'}">
          <List items="{/SkillGaps}" showSeparators="None" class="aymaxSkillGapList">
            <CustomListItem class="aymaxSkillGapItem">
              <Panel headerText="" class="aymaxCard aymaxSkillGapCard sapUiSmallMarginBottom sapUiSmallMarginEnd" width="280px">
                <VBox class="sapUiSmallMargin">
                  <Title text="{name}" level="H5" class="card-title"/>
                  <Text text="Couverture moyenne dans l'équipe" class="aymaxMetaText sapUiTinyMarginBottom"/>
                  <layout:HorizontalLayout class="aymaxProgressBarOuter">
                    <layout:HorizontalLayout class="aymaxProgressBarInner" width="{path: 'view>percent', formatter: '.formatSkillWidth'}"/>
                  </layout:HorizontalLayout>
                  <Text text="{percent}% · {headcount} employés" class="aymaxMetaText sapUiTinyMarginTop"/>
                </VBox>
              </Panel>
            </CustomListItem>
          </List>
        </VBox>

        <!-- ═══════ TAB: OBJECTIFS ═══════ -->
        <VBox visible="{= ${view>/activeTab} === 'objectifs'}">
          <List items="{/Objectives}" class="aymaxObjectiveList">
            <CustomListItem class="aymaxCard sapUiSmallMarginBottom">
              <HBox alignItems="Center" justifyContent="SpaceBetween" class="sapUiSmallMargin">
                <VBox class="aymaxObjInfo">
                  <Text text="{title}" class="aymaxObjTitle"/>
                  <Text text="{owner} · échéance {due}" class="aymaxMetaText"/>
                </VBox>
                <ObjectStatus
                  text="{path:'status', formatter:'.formatObjStatusText'}"
                  state="{path:'status', formatter:'.formatObjStatusState'}"
                  inverted="true"
                  class="aymaxStatusBadge"/>
              </HBox>
            </CustomListItem>
          </List>
        </VBox>

      </VBox>
    </content>
  </Page>
</mvc:View>

