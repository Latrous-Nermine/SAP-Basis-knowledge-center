<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.f"
  xmlns:card="sap.f.cards"
  xmlns:viz="sap.viz.ui5.controls"
  xmlns:vizData="sap.viz.ui5.data"
  xmlns:vizFeeds="sap.viz.ui5.controls.common.feeds">

  <VBox visible="{= ${view-dashboard>/role} === 'Admin' }" class="dashboardSectionGap">

    <HBox class="dashboardGap16" wrap="Wrap" width="100%">
      <!-- Quick links. "Utilisateurs" is real (navigates to the Experts
           directory, which already lists every user). "Rôles" data is
           the donut chart below. "Permissions" and "Paramètres système"
           have no owning page anywhere in this app yet - no app/admin
           module exists - so they render as disabled future-module cards
           rather than a fake link, same treatment as Intern's Room
           Stage/Rapports/Dépôt cards. -->
      <f:Card class="dashboardCard dashboardQuarterCard">

        <f:layoutData>

          <FlexItemData growFactor="1" shrinkFactor="1" baseSize="0" minWidth="220px"/>

        </f:layoutData>
        <f:content>
          <VBox class="sapUiSmallMargin">
            <Title text="{i18n-dashboard>quickLinkUsers}" level="H5"/>
            <Text text="{i18n-dashboard>quickLinkUsersDesc}" class="dashboardMetaText"/>
            <Link text="{i18n-dashboard>voirTout}" press=".onNavToUsers" class="sapUiTinyMarginTop"/>
          </VBox>
        </f:content>
      </f:Card>
      <f:Card class="dashboardCard dashboardQuarterCard dashboardCardDisabled">

        <f:layoutData>

          <FlexItemData growFactor="1" shrinkFactor="1" baseSize="0" minWidth="220px"/>

        </f:layoutData>
        <f:content>
          <VBox class="sapUiSmallMargin">
            <Title text="{i18n-dashboard>quickLinkRoles}" level="H5"/>
            <Text text="{i18n-dashboard>quickLinkRolesDesc}" class="dashboardMetaText"/>
            <ObjectStatus text="{i18n-dashboard>comingSoon}" state="None" class="sapUiTinyMarginTop"/>
          </VBox>
        </f:content>
      </f:Card>
    </HBox>

    <!-- Répartition des utilisateurs par rôle (donut, real data) paired
         with Statistiques de la plateforme (plain numbers) in one
         half/half row. Previously the donut sat alone in a full-width,
         240px-tall card: a circular chart is constrained by the smaller
         of its two dimensions, so a ~1336x240 container drew a small
         circle surrounded by dead horizontal space either side - the
         exact "tiny visualization in a huge empty area" symptom. Halving
         the width and raising the height to 320px gives it a
         near-square container, the correct aspect for a donut/pie. -->
    <HBox class="dashboardGap16" wrap="Wrap" width="100%">
      <f:Card class="dashboardCard dashboardHalfCard">

        <f:layoutData>

          <FlexItemData growFactor="1" shrinkFactor="1" baseSize="0" minWidth="320px"/>

        </f:layoutData>
        <f:header>
          <card:Header title="{i18n-dashboard>roleDistributionTitle}"/>
        </f:header>
        <f:content>
          <viz:VizFrame
            vizType="donut"
            width="100%"
            height="320px"
            uiConfig="{applicationSet:'fiori'}" vizProperties="{title:{visible:false}}">
            <viz:dataset>
              <vizData:FlattenedDataset data="{view-dashboard>/admin/roleDistribution}">
                <vizData:dimensions>
                  <vizData:DimensionDefinition name="Rôle" value="{view-dashboard>name}"/>
                </vizData:dimensions>
                <vizData:measures>
                  <vizData:MeasureDefinition name="Utilisateurs" value="{view-dashboard>count}"/>
                </vizData:measures>
              </vizData:FlattenedDataset>
            </viz:dataset>
            <viz:feeds>
              <vizFeeds:FeedItem uid="size" type="Measure" values="Utilisateurs"/>
              <vizFeeds:FeedItem uid="color" type="Dimension" values="Rôle"/>
            </viz:feeds>
          </viz:VizFrame>
        </f:content>
      </f:Card>

      <!-- Statistiques de la plateforme - deliberately plain KPI numbers,
           not a chart (see the chart-selection discussion earlier this
           session: unrelated counts at different magnitudes, neither
           comparable categories nor parts of a whole - a chart here
           would be the exact anti-pattern of forcing visualization onto
           data that doesn't call for it). -->
      <f:Card class="dashboardCard dashboardHalfCard">

        <f:layoutData>

          <FlexItemData growFactor="1" shrinkFactor="1" baseSize="0" minWidth="320px"/>

        </f:layoutData>
        <f:header>
          <card:Header title="{i18n-dashboard>platformStatsTitle}"/>
        </f:header>
        <f:content>
          <HBox justifyContent="SpaceBetween" wrap="Wrap" class="sapUiSmallMargin">
            <VBox alignItems="Center" class="dashboardStatCell">
              <Title text="{view-dashboard>/admin/platformStats/publications}" level="H3"/>
              <Text text="{i18n-dashboard>statPublications}" class="dashboardMetaText"/>
            </VBox>
            <VBox alignItems="Center" class="dashboardStatCell">
              <Title text="{view-dashboard>/admin/platformStats/questions}" level="H3"/>
              <Text text="{i18n-dashboard>statQuestions}" class="dashboardMetaText"/>
            </VBox>
            <VBox alignItems="Center" class="dashboardStatCell">
              <Title text="{view-dashboard>/admin/platformStats/knowledgeItems}" level="H3"/>
              <Text text="{i18n-dashboard>statKnowledgeItems}" class="dashboardMetaText"/>
            </VBox>
            <VBox alignItems="Center" class="dashboardStatCell">
              <Title text="{view-dashboard>/admin/platformStats/activeRooms}" level="H3"/>
              <Text text="{i18n-dashboard>statActiveRooms}" class="dashboardMetaText"/>
            </VBox>
          </HBox>
        </f:content>
      </f:Card>
    </HBox>

  </VBox>
</core:FragmentDefinition>
