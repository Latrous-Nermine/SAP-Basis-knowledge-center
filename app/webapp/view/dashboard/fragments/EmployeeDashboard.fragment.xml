<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.f"
  xmlns:card="sap.f.cards">

  <VBox visible="{= ${view-dashboard>/role} === 'Employee' }" class="dashboardSectionGap">

    <!-- Activité de connaissance - 5 counters straight from
         getDashboard().employee.activityStats, already normalised by the
         backend (2 real: Publications/Commentaires, 3 gap: Questions
         posées/Réponses/Réponses acceptées - see Phase 4). -->
    <f:Card class="dashboardCard">
      <f:content>
        <VBox class="dashboardActivityCard">
          <Text text="{i18n-dashboard>activityStatsTitle}" class="dashboardCardKicker"/>
          <HBox items="{view-dashboard>/employee/activityStats}" justifyContent="SpaceBetween" class="sapUiSmallMarginTop dashboardActivityRow">
            <VBox alignItems="Center" class="dashboardStatCell dashboardActivityCell">
              <Title text="{view-dashboard>value}" level="H3"/>
              <Text text="{view-dashboard>label}" class="dashboardMetaText"/>
            </VBox>
          </HBox>
        </VBox>
      </f:content>
    </f:Card>

    <HBox class="dashboardGap16" wrap="Wrap" width="100%">
      <!-- My Notifications - independent OData call to NotificationService,
           own-inbox @restrict already enforced server-side. -->
      <f:Card class="dashboardCard dashboardHalfCard">

        <f:layoutData>

          <FlexItemData growFactor="1" shrinkFactor="1" baseSize="0" minWidth="320px"/>

        </f:layoutData>
        <f:header>
          <card:Header title="{i18n-dashboard>notificationsTitle}"/>
        </f:header>
        <f:content>
          <VBox class="sapUiSmallMargin">
            <List
              items="{path:'notification>/Notifications', parameters:{$orderby:'createdAt desc'}}"
              growing="true"
              growingThreshold="5"
              noDataText="{i18n-dashboard>noNotifications}"
              showSeparators="None">
              <StandardListItem
                icon="{path:'notification>type', formatter:'.formatter.notificationIcon'}"
                title="{path:'notification>type'}"
                info="{path:'notification>createdAt', formatter:'.formatter.relativeDateTime'}"
                type="Inactive"
                class="dashboardNotificationRow"/>
            </List>
            <Link text="{i18n-dashboard>voirTout}" press=".onNavToNotifications" class="sapUiSmallMargin"/>
          </VBox>
        </f:content>
      </f:Card>

      <!-- Recent Knowledge - independent OData call to KnowledgeService,
           its own row-level @restrict (approved-or-own) already enforced. -->
      <f:Card class="dashboardCard dashboardHalfCard">

        <f:layoutData>

          <FlexItemData growFactor="1" shrinkFactor="1" baseSize="0" minWidth="320px"/>

        </f:layoutData>
        <f:header>
          <card:Header title="{i18n-dashboard>recentKnowledgeTitle}"/>
        </f:header>
        <f:content>
          <VBox class="sapUiSmallMargin">
            <List
              items="{path:'knowledge>/KnowledgeItems', parameters:{$orderby:'publishedAt desc'}, filters:[{path:'status',operator:'EQ',value1:'approved'}]}"
              growing="true"
              growingThreshold="5"
              noDataText="{i18n-dashboard>noRecentKnowledge}"
              showSeparators="None">
              <StandardListItem
                title="{knowledge>title}"
                type="Navigation"
                press=".onNavToKnowledgeItem"/>
            </List>
            <Link text="{i18n-dashboard>voirTout}" press=".onNavToKnowledge" class="sapUiSmallMargin"/>
          </VBox>
        </f:content>
      </f:Card>
    </HBox>

    <HBox class="dashboardGap16" wrap="Wrap" width="100%">
      <!-- Trending Topics - FeedService.getTrendingTags(), controller-
           fetched into the view model (function import, not an entity set). -->
      <f:Card class="dashboardCard dashboardHalfCard">

        <f:layoutData>

          <FlexItemData growFactor="1" shrinkFactor="1" baseSize="0" minWidth="320px"/>

        </f:layoutData>
        <f:header>
          <card:Header title="{i18n-dashboard>trendingTopicsTitle}"/>
        </f:header>
        <f:content>
          <VBox class="sapUiSmallMargin">
            <HBox wrap="Wrap" items="{view-dashboard>/trendingTopics}">
              <Text text="{view-dashboard>name}" class="dashboardTagChip"/>
            </HBox>
            <Text text="{i18n-dashboard>noTrendingTopics}" visible="{= ${view-dashboard>/trendingTopics}.length === 0 }" class="dashboardMetaText"/>
          </VBox>
        </f:content>
      </f:Card>

      <!-- Suggested Experts - FeedService.getSuggestedExperts(), same
           reasoning as Trending Topics. -->
      <f:Card class="dashboardCard dashboardHalfCard">

        <f:layoutData>

          <FlexItemData growFactor="1" shrinkFactor="1" baseSize="0" minWidth="320px"/>

        </f:layoutData>
        <f:header>
          <card:Header title="{i18n-dashboard>suggestedExpertsTitle}"/>
        </f:header>
        <f:content>
          <List items="{view-dashboard>/suggestedExperts}" noDataText="{i18n-dashboard>noSuggestedExperts}" showSeparators="None">
            <CustomListItem type="Active" press=".onNavToExpertProfile">
              <HBox alignItems="Center" class="sapUiSmallMargin">
                <Avatar
                  displaySize="M"
                  initials="{path:'view-dashboard>displayName', formatter:'.formatter.initials'}"
                  backgroundColor="{path:'view-dashboard>userID', formatter:'.formatter.avatarColorFromID'}"
                  class="sapUiSmallMarginEnd"/>
                <VBox>
                  <Text text="{view-dashboard>displayName}"/>
                  <Text text="{view-dashboard>jobTitle}" class="dashboardMetaText"/>
                </VBox>
              </HBox>
            </CustomListItem>
          </List>
        </f:content>
      </f:Card>
    </HBox>

    <HBox class="dashboardGap16" wrap="Wrap" width="100%">
      <!-- Compétences - own PeopleService.People.skills, same control as
           Profile's Expertise tab. -->
      <f:Card class="dashboardCard dashboardHalfCard">

        <f:layoutData>

          <FlexItemData growFactor="1" shrinkFactor="1" baseSize="0" minWidth="320px"/>

        </f:layoutData>
        <f:header>
          <card:Header title="{i18n-dashboard>skillsTitle}"/>
        </f:header>
        <f:content>
          <VBox class="sapUiSmallMargin">
            <List items="{view-dashboard>/employee/skills}" noDataText="{i18n-dashboard>noSkills}" showSeparators="None">
              <CustomListItem>
                <VBox class="dashboardSkillRow">
                  <HBox justifyContent="SpaceBetween">
                    <Text text="{view-dashboard>skillName}"/>
                    <Text text="{= ${view-dashboard>percent} + '%' }" class="dashboardMetaText"/>
                  </HBox>
                  <ProgressIndicator percentValue="{view-dashboard>percent}" displayValue="" class="sapUiTinyMarginTop"/>
                </VBox>
              </CustomListItem>
            </List>
          </VBox>
        </f:content>
      </f:Card>

      <!-- Certifications - own PeopleService.People.certifications, same
           three groups as Profile. -->
      <f:Card class="dashboardCard dashboardHalfCard">

        <f:layoutData>

          <FlexItemData growFactor="1" shrinkFactor="1" baseSize="0" minWidth="320px"/>

        </f:layoutData>
        <f:header>
          <card:Header title="{i18n-dashboard>certificationsTitle}"/>
        </f:header>
        <f:content>
          <VBox class="sapUiSmallMargin dashboardGap16">
            <IllustratedMessage
              visible="{= ${view-dashboard>/employee/certsEarned}.length + ${view-dashboard>/employee/certsInProgress}.length + ${view-dashboard>/employee/certsRecommended}.length === 0 }"
              illustrationType="SimpleEmptyList"
              illustrationSize="Spot"
              title="{i18n-dashboard>certEmptyTitle}"
              description="{i18n-dashboard>certEmptyDescription}"/>

            <VBox visible="{= ${view-dashboard>/employee/certsEarned}.length > 0 }">
              <Text text="{i18n-dashboard>certEarned}" class="dashboardCardKickerSuccess"/>
              <List items="{view-dashboard>/employee/certsEarned}" showSeparators="None">
                <StandardListItem title="{view-dashboard>certification/name}"/>
              </List>
            </VBox>
            <VBox visible="{= ${view-dashboard>/employee/certsInProgress}.length > 0 }">
              <Text text="{i18n-dashboard>certInProgress}" class="dashboardCardKickerInfo"/>
              <List items="{view-dashboard>/employee/certsInProgress}" showSeparators="None">
                <StandardListItem title="{view-dashboard>certification/name}"/>
              </List>
            </VBox>
            <VBox visible="{= ${view-dashboard>/employee/certsRecommended}.length > 0 }">
              <Text text="{i18n-dashboard>certRecommended}" class="dashboardCardKickerWarning"/>
              <List items="{view-dashboard>/employee/certsRecommended}" showSeparators="None">
                <StandardListItem title="{view-dashboard>certification/name}"/>
              </List>
            </VBox>
          </VBox>
        </f:content>
      </f:Card>
    </HBox>

    <Button text="{i18n-dashboard>viewTimeline}" icon="sap-icon://history" press=".onOpenTimeline" class="dashboardTimelineButton"/>

  </VBox>
</core:FragmentDefinition>
