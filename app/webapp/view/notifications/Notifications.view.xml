<mvc:View
  controllerName="aymax.hub.controller.notifications.Notifications"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:f="sap.f"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <!-- sap.f.DynamicPage needs a height:100% ancestor to size itself against -
       UI5's own theme CSS provides that chain starting from sap.m.App, not
       from DynamicPage itself. Without this wrapper the page silently
       collapses to its intrinsic header height and clips everything below
       it - this was the real cause behind this app's long-standing
       "renders once then goes blank" issue. -->
  <App>
  <f:DynamicPage id="notificationsPage" headerExpanded="false" class="aymaxPage">

    <f:title>
      <f:DynamicPageTitle>
        <f:heading>
          <HBox alignItems="Center">
            <Title text="{i18n-notifications>appTitle}" level="H3"/>
          </HBox>
        </f:heading>
        <f:actions>
          <Button
            icon="sap-icon://home"
            type="Transparent"
            tooltip="{i18n-notifications>backToFeed}"
            press=".onHomePress"/>
          <Button
            icon="sap-icon://bell"
            type="Transparent"
            text="{view-notifications>/unreadCount}"
            tooltip="{i18n-notifications>appTitle}"/>
        </f:actions>
      </f:DynamicPageTitle>
    </f:title>

    <f:content>
      <!-- Design (docs/design/Notifications.md) uses a centered, 760px wide
           reading column, not a full width list. HBox plus justifyContent
           reproduces that with layout properties only, no inline style. -->
      <HBox justifyContent="Center" class="sapUiContentPadding">
        <VBox width="760px" class="sapUiResponsiveMargin notificationsCard">

          <Toolbar>
            <Title text="{i18n-notifications>pageTitle}" level="H2"/>
            <ToolbarSpacer/>
            <Button
              text="{i18n-notifications>markAllRead}"
              type="Transparent"
              press=".onMarkAllRead"/>
          </Toolbar>

          <List
            id="notificationList"
            class="notificationsList"
            items="{ path: 'notification>/Notifications', sorter: { path: 'createdAt', descending: true } }"
            growing="true"
            growingThreshold="20"
            noDataText="{i18n-notifications>noNotifications}">
            <NotificationListItem
              title="{ parts: [{ path: 'notification>type' }, { path: 'notification>params' }], formatter: '.formatter.notificationText' }"
              description="{ parts: [{ path: 'notification>type' }, { path: 'notification>createdAt', targetType: 'any' }], formatter: '.formatter.notificationMeta' }"
              authorPicture="{ path: 'notification>type', formatter: '.formatter.notificationIcon' }"
              priority="{ path: 'notification>severity', formatter: '.formatter.notificationPriority' }"
              unread="{= !${notification>isRead} }"
              press=".onNotificationPress"/>
          </List>
        </VBox>
      </HBox>
    </f:content>
  </f:DynamicPage>
  </App>
</mvc:View>
