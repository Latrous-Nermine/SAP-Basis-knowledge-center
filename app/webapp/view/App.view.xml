<mvc:View
  controllerName="aymax.hub.controller.App"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <VBox fitContainer="true">
    <HBox class="aymaxHeader" alignItems="Center" justifyContent="SpaceBetween">
      <HBox alignItems="Center" class="aymaxHeaderLeft">
        <HBox class="aymaxLogo" alignItems="Center">
          <Avatar displaySize="XS" initials="A" class="sapUiTinyMarginEnd aymaxLogoAvatar"/>
          <VBox>
            <Title text="AYMAX" titleStyle="H5"/>
            <Text text="knowledge hub" class="aymaxLogoSub"/>
          </VBox>
        </HBox>

        <!-- Four product-area groups (2026-08 navbar redesign), replacing
             the old flat row of 19 links - explicit feedback that it read
             as a developer menu ("too many elements on one line") rather
             than a professional product, and it was the direct cause of a
             confirmed horizontal-overflow bug on mobile (the row simply
             never fit). Accueil/Knowledge use buttonMode="Split": the main
             face navigates straight to that group's obvious primary page
             (dashboard / Centre de connaissances) exactly like a normal
             nav link did before, and only the small arrow opens the
             dropdown for the rest of the group. Learning/Company have no
             single "primary" page, so the whole button opens their menu.
             Every MenuItem gets its own dedicated press handler (never
             core:CustomData - a control's default items/content
             aggregation on a layout control has already been confirmed
             more than once this session to reject a bare nested
             CustomData; the same one-handler-per-item pattern already
             used for KnowledgeList's category picker tiles is reused here
             for the same reason). -->
        <HBox class="aymaxNavGroups sapUiSmallMarginBegin" alignItems="Center">

          <MenuButton
            id="navGroupAccueil"
            text="{i18n>navGroupAccueil}"
            type="Transparent"
            buttonMode="Split"
            defaultAction=".onNavDashboard"
            class="aymaxNavGroupBtn">
            <menu>
              <Menu>
                <items>
                  <MenuItem text="{i18n>navFeed}" press=".onNavFeed"/>
                </items>
              </Menu>
            </menu>
          </MenuButton>

          <!-- 2026-09 fix: was buttonMode="Split" with defaultAction=
               onNavKnowledge - clicking the "Connaissances" label went
               straight to the Knowledge Center, and Questions/Experts/
               Tags/Rooms were reachable only via the separate, easy-to-miss
               arrow hit-area (confirmed live: reported as "Questions page
               not accessible from the navbar"). Plain MenuButton now,
               matching Learning/Company below - any click opens the full
               list, Knowledge Center included as its own first item so it
               stays exactly as reachable as before, just no longer hidden
               behind a two-target split control. -->
          <MenuButton
            id="navGroupKnowledge"
            text="{i18n>navGroupKnowledge}"
            type="Transparent"
            class="aymaxNavGroupBtn">
            <menu>
              <Menu>
                <items>
                  <MenuItem text="{i18n>navKnowledge}" press=".onNavKnowledge"/>
                  <MenuItem text="{i18n>navQuestions}" press=".onNavQuestions"/>
                  <MenuItem text="{i18n>navExperts}" press=".onNavExperts"/>
                  <MenuItem text="{i18n>navTags}" press=".onNavTags"/>
                  <MenuItem text="{i18n>navRooms}" press=".onNavRooms"/>
                </items>
              </Menu>
            </menu>
          </MenuButton>

          <MenuButton
            id="navGroupLearning"
            text="{i18n>navGroupLearning}"
            type="Transparent"
            class="aymaxNavGroupBtn">
            <menu>
              <Menu>
                <items>
                  <MenuItem text="{i18n>navBasisAcademy}" press=".onNavBasisAcademy"/>
                  <MenuItem text="{i18n>navCertifications}" press=".onNavCertifications"/>
                </items>
              </Menu>
            </menu>
          </MenuButton>

          <!-- Company - Admin is folded in here even though the user's own
               illustrative grouping omitted it, so its existing route
               stays reachable from the nav (flagged explicitly rather than
               silently dropping a working route). -->
          <MenuButton
            id="navGroupCompany"
            text="{i18n>navGroupCompany}"
            type="Transparent"
            class="aymaxNavGroupBtn">
            <menu>
              <Menu>
                <items>
                  <MenuItem text="{i18n>navExcellenceCenter}" press=".onNavExcellenceCenter"/>
                  <MenuItem text="{i18n>navRewards}" press=".onNavRewards"/>
                  <MenuItem id="navItemHr" text="{i18n>navHR}" press=".onNavHR"/>
                  <MenuItem id="navItemDepot" text="{i18n>navDepot}" press=".onNavDepot"/>
                  <MenuItem id="navItemRapportsStage" text="{i18n>navRapportsStage}" press=".onNavRapportsStage"/>
                  <MenuItem text="{i18n>navReports}" press=".onNavReports"/>
                  <MenuItem id="navItemValidation" text="{i18n>navValidation}" press=".onNavValidation"/>
                  <MenuItem id="navItemAdmin" text="{i18n>navAdmin}" press=".onNavAdmin"/>
                </items>
              </Menu>
            </menu>
          </MenuButton>

        </HBox>
      </HBox>

      <HBox alignItems="Center" class="aymaxHeaderRight">
        <SearchField
          id="shellSearchField"
          width="240px"
          placeholder="{i18n>headerSearchPlaceholder}"
          search=".onHeaderSearch"
          class="sapUiSmallMarginEnd aymaxShellSearch"/>

        <!-- Same theme-toggle / notifications-bell pair as the standalone
             Lot 1 app's header (app/feed/webapp/view/App.view.xml) -
             this shell had neither, an inconsistency once users started
             crossing between the two apps via the shared nav links.
             Bell hides on the Notifications page itself: clicking a
             bell to go to the page you're already on is a no-op that
             only invites confusion. -->
        <Button icon="sap-icon://light-mode" type="Transparent" press=".onToggleTheme" tooltip="{i18n>themeToggleTooltip}" class="sapUiTinyMarginEnd"/>
        <Button id="navBtnNotificationBell" icon="sap-icon://bell" type="Transparent" press=".onNotificationsBellPress" tooltip="{i18n>navNotifications}" class="sapUiTinyMarginEnd"/>

        <!-- Account/avatar menu (2026-08 navbar redesign) - "Profil" moves
             here from the old flat nav row, the same place a person expects
             to find their own account, not mixed in among page links.
             Bound to view>/myProfile (App.controller.js#onInit resolves
             people>/MyProfile once, the same CAP entity Profile.controller.js
             already reads for the caller's own avatar/displayName - zero new
             backend). Menu opens imperatively via Menu#openBy - MenuButton
             itself can't show a real photo (its own icon property only
             takes an icon URI, not a control), so this is a plain pressable
             Avatar instead. -->
        <Avatar
          id="navProfileAvatar"
          displaySize="XS"
          src="{view>/myProfile/avatarSrc}"
          initials="{view>/myProfile/initials}"
          backgroundColor="{view>/myProfile/color}"
          press=".onProfileMenuPress"
          tooltip="{i18n>navProfile}"
          class="aymaxNavProfileAvatar sapUiSmallMarginEnd"/>

        <!-- DEV-ONLY role preview (CLAUDE.md §5 C7 exception) - lets
             anyone browsing locally preview each role's dashboard
             without a private-window relogin. Real auth is untouched;
             see model/devRole.js for exactly what this does and does
             not change. Must be removed before the real XSUAA rollout
             (TODO-INTEGRATION.md). -->
        <HBox alignItems="Center" class="aymaxDevRoleBox">
          <Label text="{i18n>devRoleLabel}" class="sapUiTinyMarginEnd aymaxDevRoleLabel" labelFor="devRoleSelect"/>
          <Select id="devRoleSelect" width="170px" change=".onDevRoleChange" class="aymaxDevRoleSelect">
            <core:Item key="" text="{i18n>devRoleReal}"/>
            <core:Item key="Employee" text="{i18n>devRoleEmployee}"/>
            <core:Item key="Manager" text="{i18n>devRoleManager}"/>
            <core:Item key="HR" text="{i18n>devRoleHR}"/>
            <core:Item key="Administrator" text="{i18n>devRoleAdmin}"/>
            <core:Item key="Intern" text="{i18n>devRoleIntern}"/>
          </Select>
        </HBox>
      </HBox>
    </HBox>

    <!-- Each migrated module's target view gets pushed into this
         NavContainer by the router; nothing here changes as modules arrive. -->
    <App>
      <NavContainer id="appNavContainer"/>
    </App>
  </VBox>
</mvc:View>
