<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">

  <Dialog
    title="{view-basisAcademy>/dialog/title}"
    contentWidth="560px"
    contentHeight="560px"
    verticalScrolling="true">
    <content>
      <VBox class="sapUiContentPadding">

        <Text
          text="{i18n-basisAcademy>domainDialogStepsTitle}"
          class="aymaxMeta sapUiSmallMarginBottom"/>

        <List items="{view-basisAcademy>/dialog/steps}" showSeparators="None">
          <CustomListItem class="baStepCard">
            <VBox class="sapUiSmallMargin">

              <HBox justifyContent="SpaceBetween" alignItems="Start" class="sapUiTinyMarginBottom">
                <Title text="{view-basisAcademy>title}" level="H5" class="baStepTitle" wrapping="true"/>
                <ObjectStatus
                  text="{view-basisAcademy>statusLabel}"
                  state="{path:'view-basisAcademy>status', formatter:'.formatter.stepStatusState'}"
                  inverted="true"
                  visible="{view-basisAcademy>isMemberContext}"/>
              </HBox>

              <Text text="{view-basisAcademy>desc}" class="aymaxMeta sapUiTinyMarginBottom" wrapping="true"/>

              <HBox alignItems="Center" wrap="Wrap" class="sapUiTinyMarginBottom">
                <core:Icon src="{path:'view-basisAcademy>type', formatter:'.formatter.assessmentTypeIcon'}" size="0.8rem" class="baLegendIcon baLegendIconMuted sapUiTinyMarginEnd"/>
                <Text text="{view-basisAcademy>typeLabel}" class="baStepMeta sapUiSmallMarginEnd"/>
                <Text text="{i18n-basisAcademy>domainDialogPrereqTitle}:" class="baStepMeta sapUiTinyMarginEnd"/>
                <Text text="{view-basisAcademy>prereqLabel}" class="baStepMeta sapUiTinyMarginEnd"/>
                <Text text="{i18n-basisAcademy>stepImportantBadge}" class="baImportantBadge" visible="{view-basisAcademy>important}"/>
              </HBox>

              <Text
                text="{i18n-basisAcademy>managerReviewHint}"
                class="aymaxMeta sapUiTinyMarginBottom"
                visible="{= ${view-basisAcademy>important} === true &amp;&amp; ${view-basisAcademy>status} === 'inProgress' }"/>

              <!-- Member actions (own progress, not a Manager reviewing someone else).
                   Step title comes from the button's own binding context in the
                   handler (getBindingContext), not customData - simpler, and
                   matches how every other per-row action in this app already
                   reads its row's data (e.g. KnowledgeDetail's vote buttons). -->
              <HBox justifyContent="End" visible="{= ${view-basisAcademy>isMemberContext} === true &amp;&amp; ${view-basisAcademy>isManagerViewing} === false }">
                <Button
                  text="{i18n-basisAcademy>btnStart}"
                  type="Emphasized"
                  press=".onStepStart"
                  visible="{= ${view-basisAcademy>status} === 'notStarted' }"/>
                <Button
                  text="{i18n-basisAcademy>btnTakeAssessment}"
                  type="Emphasized"
                  press=".onStepTakeAssessment"
                  visible="{= ${view-basisAcademy>status} === 'inProgress' }"/>
              </HBox>

              <!-- Manager actions (reviewing a team member's in-progress step) -->
              <HBox justifyContent="End" visible="{= ${view-basisAcademy>isManagerViewing} === true &amp;&amp; ${view-basisAcademy>status} === 'inProgress' }">
                <Button
                  text="{i18n-basisAcademy>btnRequestRetake}"
                  type="Reject"
                  icon="sap-icon://decline"
                  press=".onStepRequestRetake"
                  class="sapUiSmallMarginEnd"/>
                <Button
                  text="{i18n-basisAcademy>btnValidate}"
                  type="Accept"
                  icon="sap-icon://accept"
                  press=".onStepValidate"/>
              </HBox>

            </VBox>
          </CustomListItem>
        </List>

      </VBox>
    </content>
    <endButton>
      <Button text="{i18n-basisAcademy>close}" press=".onCloseDomainDialog"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>
