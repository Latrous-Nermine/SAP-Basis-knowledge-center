<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:form="sap.ui.layout.form">

  <Dialog title="{i18n-experts>filtersDialogTitle}" contentWidth="32rem" verticalScrolling="false">
    <content>
      <form:SimpleForm
        editable="true"
        layout="ResponsiveGridLayout"
        labelSpanM="3" labelSpanL="3" labelSpanXL="3"
        emptySpanM="0"
        class="sapUiContentPadding expertsFilterForm">

        <Label text="{i18n-experts>filterExpertiseLevel}"/>
        <Select selectedKey="{view-experts>/filters/expertiseLevel}" width="100%">
          <core:Item key="" text="{i18n-experts>filterAll}"/>
          <core:Item key="Débutant" text="{i18n-experts>level.Debutant}"/>
          <core:Item key="Contributeur" text="{i18n-experts>level.Contributeur}"/>
          <core:Item key="Expert" text="{i18n-experts>level.Expert}"/>
          <core:Item key="Spécialiste" text="{i18n-experts>level.Specialiste}"/>
          <core:Item key="Master" text="{i18n-experts>level.Master}"/>
        </Select>

        <Label text="{i18n-experts>filterAvailability}"/>
        <Select selectedKey="{view-experts>/filters/availability}" width="100%">
          <core:Item key="" text="{i18n-experts>filterAll}"/>
          <core:Item key="available" text="{i18n-experts>availability.available}"/>
          <core:Item key="busy" text="{i18n-experts>availability.busy}"/>
          <core:Item key="unavailable" text="{i18n-experts>availability.unavailable}"/>
        </Select>

        <Label text="{i18n-experts>filterTechnology}"/>
        <MultiComboBox
          selectedKeys="{view-experts>/filters/technologies}"
          items="{path:'view-experts>/technologyOptions', templateShareable:'false'}"
          width="100%">
          <core:Item key="{view-experts>key}" text="{view-experts>text}"/>
        </MultiComboBox>

        <Label text="{i18n-experts>filterSkill}"/>
        <Input value="{view-experts>/filters/skill}" placeholder="{i18n-experts>filterSkillPlaceholder}" width="100%"/>

      </form:SimpleForm>
    </content>
    <beginButton>
      <Button text="{i18n-experts>filterReset}" press=".onResetFilters"/>
    </beginButton>
    <endButton>
      <Button text="{i18n-experts>filterApply}" type="Emphasized" press=".onApplyFilters"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>
