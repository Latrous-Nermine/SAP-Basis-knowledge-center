<mvc:View
  controllerName="aymax.hub.controller.experts.ExpertsList"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <Page showHeader="false" showNavButton="false" busy="{view-experts>/busy}" busyIndicatorDelay="0" class="aymaxPage">
    <content>
      <VBox class="expertsContentContainer">

        <!-- Title row matches Certification's pattern (showHeader=false +
             self-built title), 2026-08 polish pass. -->
        <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiMediumMarginTop sapUiMediumMarginBottom">
          <Title text="{i18n-experts>pageTitle}" level="H1" class="aymaxPageTitle"/>
          <Button icon="sap-icon://home" type="Transparent" tooltip="{i18n-experts>backToFeed}" press=".onHomePress"/>
        </HBox>

        <VBox class="expertsStickyFilters">
          <Toolbar>
            <ToolbarSpacer/>
            <Button
              text="{i18n-experts>filtersButton}"
              icon="sap-icon://filter"
              press=".onOpenFilters"/>
          </Toolbar>

          <SearchField
            placeholder="{i18n-experts>searchPlaceholder}"
            liveChange=".onSearch"
            class="sapUiSmallMarginTop sapUiSmallMarginBottom"/>

          <HBox wrap="Wrap" items="{view-experts>/departmentFilters}">
            <Button
              text="{view-experts>label}"
              type="{path:'view-experts>active', formatter:'.formatter.departmentFilterButtonType'}"
              press=".onDepartmentFilterPress"
              class="expertsFilterChip sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
          </HBox>

          <HBox wrap="Wrap" visible="{= ${view-experts>/activeFilterTokens}.length > 0 }" class="sapUiTinyMarginBottom">
            <Tokenizer tokens="{path:'view-experts>/activeFilterTokens', templateShareable:'false'}" editable="true" tokenDelete=".onRemoveFilterToken">
              <Token key="{view-experts>key}" text="{view-experts>text}"/>
            </Tokenizer>
          </HBox>
        </VBox>

        <List
          id="expertsList"
          items="{ path: 'people>/People', parameters: { $expand: 'skills,userBadges($expand=badge),technologies' }, sorter: { path: 'reputation', descending: true } }"
          growing="true"
          growingThreshold="20"
          noDataText="{i18n-experts>noExperts}"
          showSeparators="None"
          class="expertsGrid">
          <CustomListItem type="Navigation" press=".onCardPress" class="expertsCard">
            <VBox>
              <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                <Avatar
                  displaySize="L"
                  initials="{path:'people>displayName', formatter:'.formatter.initials'}"
                  backgroundColor="{path:'people>userID', formatter:'.formatter.avatarColorFromID'}"
                  class="sapUiSmallMarginEnd"/>
                <VBox class="expertsIdentity">
                  <Title text="{people>displayName}" level="H5" wrapping="true"/>
                  <Text text="{people>jobTitle}" class="expertsMeta"/>
                  <Text text="{people>department}" class="expertsMeta"/>
                </VBox>
              </HBox>

              <HBox wrap="Wrap" items="{path:'people>technologies', templateShareable:'false'}" class="expertsChipsRow">
                <Text text="{people>technologyName}" class="expertsTechChip"/>
              </HBox>

              <HBox wrap="Wrap" items="{path:'people>userBadges', templateShareable:'false'}" class="expertsChipsRow">
                <Text text="{people>badge/name}" class="expertsBadgeChip"/>
              </HBox>

              <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginTop">
                <ObjectStatus
                  text="{path:'people>availability', formatter:'.formatter.availabilityLabel'}"
                  state="{path:'people>availability', formatter:'.formatter.availabilityState'}"/>
                <Text text="{path:'people>yearsOfExperience', formatter:'.formatter.yearsOfExperienceLabel'}" class="expertsMeta"/>
              </HBox>

              <HBox justifyContent="SpaceBetween" class="expertsCardFooter">
                <Text text="{path:'people>reputation', formatter:'.formatter.reputationLabel'}"/>
                <Text text="{path:'people>contributionsCount', formatter:'.formatter.contributionsLabel'}"/>
              </HBox>

              <OverflowToolbar class="sapUiTinyMarginTop expertsCardActions">
                <Button text="{i18n-experts>contact}" icon="sap-icon://email" type="Transparent" press=".onContactPress" tooltip="{i18n-experts>contact}"/>
                <Button
                  text="{path:'people>isFollowedByMe', formatter:'.formatter.followButtonText'}"
                  icon="{path:'people>isFollowedByMe', formatter:'.formatter.followButtonIcon'}"
                  type="{path:'people>isFollowedByMe', formatter:'.formatter.followButtonType'}"
                  visible="{= ${people>userID} !== ${view-experts>/currentUserID} }"
                  press=".onFollowPress"/>
                <Button text="{i18n-experts>viewProfile}" type="Emphasized" press=".onViewProfilePress"/>
                <Button text="{i18n-experts>askQuestion}" icon="sap-icon://discussion-2" type="Transparent" press=".onAskQuestionPress"/>
              </OverflowToolbar>
            </VBox>
          </CustomListItem>
        </List>
      </VBox>
    </content>
  </Page>
</mvc:View>
