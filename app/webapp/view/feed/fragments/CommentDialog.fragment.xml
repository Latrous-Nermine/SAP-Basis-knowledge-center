<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">

  <Dialog id="commentDialog" title="Commentaires" contentWidth="620px" contentHeight="560px" resizable="true" class="aymaxCommentDialog">
    <content>
      <VBox width="100%" height="100%" class="sapUiContentPadding aymaxCommentDialogBody">
        <VBox visible="{= !!${comment>/replyTo} }" class="aymaxReplyBanner sapUiSmallMarginBottom">
          <HBox alignItems="Center" justifyContent="SpaceBetween">
            <VBox>
              <Text text="Réponse en cours" class="aymaxMeta"/>
              <Text text="{= 'À ' + (${comment>/replyTo/author/displayName} || 'un commentaire') }" class="aymaxCommentReplyLabel"/>
            </VBox>
            <Button text="Annuler" type="Transparent" press=".onCancelReplyToComment"/>
          </HBox>
        </VBox>
        <List
          id="commentList"
          items="{comment>/comments}"
          showSeparators="Inner"
          noDataText="Aucun commentaire — soyez le premier à réagir !"
          class="sapUiSmallMarginBottom"
          width="100%">
          <CustomListItem>
            <VBox class="sapUiTinyMarginTopBottom aymaxCommentItem" width="100%">
              <HBox alignItems="Start" justifyContent="SpaceBetween">
                <HBox alignItems="Start" class="sapUiTinyMarginEnd">
                  <Avatar
                    src="{parts:[{path:'comment>author/avatarUrl'},{path:'comment>author/displayName'}], formatter:'.formatAvatar'}"
                    displaySize="XS"
                    class="sapUiTinyMarginEnd"/>
                  <VBox>
                    <Text text="{comment>author/displayName}" class="aymaxCommentAuthor"/>
                    <Text text="{path:'comment>createdAt', formatter:'.formatRelativeTime'}" class="aymaxMeta"/>
                  </VBox>
                </HBox>
                <Button text="Répondre" type="Transparent" press=".onReplyToComment"/>
              </HBox>
              <VBox visible="{= !!${comment>parent_ID} }" class="aymaxReplyContext sapUiTinyMarginTop">
                <Text text="{= 'En réponse à ' + (${comment>parentDisplayName} || 'un commentaire') }" class="aymaxMeta"/>
              </VBox>
              <Text text="{comment>content}" wrapping="true" class="sapUiTinyMarginTop"/>
            </VBox>
          </CustomListItem>
        </List>
        <VBox class="aymaxCommentComposer sapUiSmallMarginTop">
          <TextArea
            id="commentTextArea"
            value="{comment>/newText}"
            rows="3"
            growing="true"
            growingMaxLines="6"
            placeholder="Ajouter un commentaire ou une réponse..."
            width="100%"
            class="sapUiSmallMarginBottom"/>
          <HBox alignItems="Center" justifyContent="SpaceBetween">
            <Text text="{= ${comment>/replyTo} ? 'Vous répondez à un commentaire' : 'Nouveau commentaire' }" class="aymaxMeta"/>
            <Button
              icon="sap-icon://send"
              text="{= ${comment>/replyTo} ? 'Répondre' : 'Commenter' }"
              type="Emphasized"
              press=".onSendComment"
              enabled="{= ${comment>/sending} ? false : true }"
              tooltip="Envoyer le commentaire"/>
          </HBox>
        </VBox>
      </VBox>
    </content>
    <endButton>
      <Button text="Fermer" press=".onCloseCommentDialog"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>
