<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">

  <!-- "Contenu à valider" (Manager only). Lists the Knowledge Center's
       own pending items (KnowledgeItems, status = 'pending') - the ones
       an Employee sends through "Soumettre pour validation". It used to
       bind Lot 3's separate ValidationItems queue, which submitForReview
       never writes to, so a submitted contribution never showed up here.
       Approve/Reject call the same approveItem/rejectItem actions as
       KnowledgeDetail, so the workflow, reputation and notification
       logic all run server-side exactly as from the detail page. -->
  <VBox
    visible="{= ${view-knowledge>/isManager} === true &amp;&amp; ${view-knowledge>/validation/sectionVisible} === true }"
    class="sapUiLargeMarginBottom knowledgeValidationSection">
    <HBox alignItems="Center" class="sapUiTinyMarginBottom">
      <core:Icon src="sap-icon://task" size="1.1rem" class="sapUiTinyMarginEnd aymaxIconPrimary"/>
      <Title text="{i18n-knowledge>validationSectionTitle}" level="H2" class="aymaxPageTitle"/>
    </HBox>
    <Text text="{i18n-knowledge>validationSectionSubtitle}" class="aymaxMeta sapUiSmallMarginBottom"/>

    <!-- STATS -->
    <HBox class="aymaxValidationStats sapUiSmallMarginBottom" wrap="Wrap">
      <VBox class="aymaxStatPill aymaxStatPillWarning sapUiSmallMarginEnd sapUiSmallMarginBottom" alignItems="Center">
        <Title text="{view-knowledge>/validation/counts/pending}" level="H4" class="aymaxStatPillValue"/>
        <Text text="{i18n-validation>statPending}" class="aymaxMeta"/>
      </VBox>
    </HBox>

    <!-- LIST -->
    <List
      id="validationSectionList"
      items="{ path: 'knowledge>/KnowledgeItems', parameters: { $expand: 'contributors' }, filters: [{ path: 'status', operator: 'EQ', value1: 'pending' }], sorter: { path: 'createdAt', descending: true } }"
      showSeparators="None"
      noDataText="{i18n-knowledge>validationNoPending}"
      class="aymaxValidationList">
      <CustomListItem class="aymaxCard sapUiSmallMarginBottom aymaxValidationItem">
        <VBox class="sapUiSmallMargin">

          <HBox alignItems="Center" class="sapUiSmallMarginBottom">
            <ObjectStatus
              text="{i18n-knowledge>status.pending}"
              state="Warning"
              inverted="true"
              class="aymaxBadge sapUiSmallMarginEnd"/>
            <Text text="{path:'knowledge>category', formatter:'.formatter.categoryLabel'}" class="aymaxTagOutline"/>
          </HBox>

          <Title text="{knowledge>title}" level="H3" class="aymaxItemTitle sapUiTinyMarginBottom"/>
          <HBox alignItems="Center" class="sapUiSmallMarginBottom">
            <core:Icon src="sap-icon://employee" size="0.85rem" class="sapUiTinyMarginEnd aymaxIconMuted"/>
            <Text text="{knowledge>contributorsLabel}" class="aymaxMetaText sapUiTinyMarginEnd"/>
            <Text text="·" class="aymaxMetaText sapUiTinyMarginEnd"/>
            <core:Icon src="sap-icon://time" size="0.75rem" class="sapUiTinyMarginEnd aymaxIconMuted"/>
            <Text text="{path:'knowledge>createdAt', targetType:'any', formatter:'.formatter.relativeDateTime'}" class="aymaxMetaText"/>
          </HBox>
          <Text text="{knowledge>excerpt}" class="aymaxExcerpt sapUiMediumMarginBottom" wrapping="true"/>

          <HBox justifyContent="End" alignItems="Center" class="aymaxItemActions">
            <Button text="{i18n-knowledge>rejectItem}" type="Reject" icon="sap-icon://decline" press=".onValidationReject" class="sapUiSmallMarginEnd"/>
            <Button text="{i18n-knowledge>validationOpenItem}" type="Default" icon="sap-icon://display" press=".onItemPress" class="sapUiSmallMarginEnd"/>
            <Button text="{i18n-knowledge>approveItem}" type="Accept" icon="sap-icon://accept" press=".onValidationApprove"/>
          </HBox>

        </VBox>
      </CustomListItem>
    </List>
  </VBox>
</core:FragmentDefinition>
