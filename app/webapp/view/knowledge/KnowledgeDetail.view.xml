<mvc:View
  controllerName="aymax.hub.controller.knowledge.KnowledgeDetail"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:uxap="sap.uxap"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <Page showNavButton="true" navButtonPress=".onNavBack" class="aymaxPage">
    <content>

      <!-- Same max-width/centering/padding container KnowledgeList.view.xml
           already uses - without it, this was the only page in the module
           with content running edge-to-edge instead of matching the list's
           margins. Purely a width constraint (max-width/margin/padding) -
           no height/flex properties, so it doesn't interfere with
           ObjectPageLayout's own internal scroll management. -->
      <VBox class="knowledgeContentContainer">
      <uxap:ObjectPageLayout id="knowledgeObjectPage" showTitleInHeaderContent="true">

        <uxap:headerTitle>
          <uxap:ObjectPageDynamicHeaderTitle>
            <uxap:heading>
              <VBox>
                <Title text="{knowledge>title}" wrapping="true"/>
                <!-- No visible= binding: "tags" is a collection, and an
                     ODataPropertyBinding can't resolve a collection path as
                     a primitive (see KnowledgeCard.fragment.xml's own
                     tags Tokenizer for the same note) - an empty Tokenizer
                     renders with negligible height instead. -->
                <Tokenizer
                  editable="false"
                  tokens="{path:'knowledge>tags', templateShareable:'false'}"
                  class="knowledgeCardTags sapUiTinyMarginTop">
                  <Token text="{knowledge>tag/name}"/>
                </Tokenizer>
              </VBox>
            </uxap:heading>
            <uxap:actions>
            <!-- Visibility for every control below is set IMPERATIVELY from
                 the controller (_updateActionVisibility), not via a
                 declarative binding - uxap:actions on an
                 ObjectPageDynamicHeaderTitle turned out not to reliably
                 apply formatter/expression visible= bindings (found 2026-08:
                 canVote/canSubmitForReview were both silently stuck at their
                 visible=true default here, a PRE-EXISTING bug this
                 uncovered, not something the new Approve/Reject buttons
                 introduced - voting and "Soumettre" were showing on items
                 that shouldn't have allowed either). Same imperative
                 setVisible() pattern App.controller.js already uses for the
                 nav bar, which does not have this problem. -->
              <HBox
                id="voteControls"
                alignItems="Center"
                visible="false"
                class="knowledgeVoteControls sapUiTinyMarginEnd">
                <ToggleButton
                  icon="sap-icon://thumb-up"
                  text="{knowledge>upvoteCount}"
                  pressed="{path:'knowledge>myVote', formatter:'.formatter.isUpvoted'}"
                  tooltip="{i18n-knowledge>upvote}"
                  press=".onUpvotePress"/>
                <ToggleButton
                  icon="sap-icon://thumb-down"
                  text="{knowledge>downvoteCount}"
                  pressed="{path:'knowledge>myVote', formatter:'.formatter.isDownvoted'}"
                  tooltip="{i18n-knowledge>downvote}"
                  press=".onDownvotePress"
                  class="sapUiTinyMarginBegin"/>
              </HBox>
              <!-- Submit for review: no edit form/route in this app yet, so no
                   Edit button is shown here - adding one would be a new
                   feature, not a restyle. ObjectPageLayout keeps this pinned
                   via its own sticky header, replacing the earlier CSS
                   sticky-toolbar hack. -->
              <Button
                id="btnSubmitForReview"
                text="{i18n-knowledge>submitForReview}"
                type="Emphasized"
                press=".onSubmitForReview"
                visible="false"/>
              <!-- Approve/Reject (2026-08) - shown when status is pending AND
                   the viewer resolved as Manager (view-knowledge>/isManager,
                   set in onInit); the real gate is the backend's own
                   @requires:'Manager' on approveItem/rejectItem regardless. -->
              <Button
                id="btnApproveItem"
                text="{i18n-knowledge>approveItem}"
                type="Accept"
                press=".onApproveItem"
                visible="false"/>
              <Button
                id="btnRejectItem"
                text="{i18n-knowledge>rejectItem}"
                type="Reject"
                press=".onRejectItem"
                visible="false"/>
            </uxap:actions>
          </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>

        <uxap:headerContent>
          <VBox class="knowledgeDetailHeaderMeta">
            <HBox wrap="Wrap" alignItems="Center" class="knowledgeCardBadgeGroup sapUiTinyMarginBottom">
              <ObjectStatus text="{path:'knowledge>category', formatter:'.formatter.categoryLabel'}" state="Information"/>
              <!-- visible= set imperatively (_updateActionVisibility) -
                   uxap:headerContent turns out to share the SAME declarative
                   visible= unreliability already documented for uxap:actions
                   below (found 2026-08 via the same kind of real testing:
                   this badge stayed visible on approved items regardless of
                   the formatter). Not a new pattern, just extending an
                   already-proven one to two controls that needed it too. -->
              <ObjectStatus
                id="statusBadge"
                text="{path:'knowledge>status', formatter:'.formatter.statusLabel'}"
                state="{path:'knowledge>status', formatter:'.formatter.statusState'}"/>
              <core:Icon
                src="sap-icon://sys-help-2"
                visible="{knowledge>fromQuestion}"
                tooltip="{path:'knowledge>fromQuestion', formatter:'.formatter.fromQuestionTooltip'}"
                class="knowledgeFromQuestionIcon"/>
              <Text
                id="topicChip"
                text="{path:'knowledge>topic/name', formatter:'.formatter.topicName'}"
                class="knowledgeCardTopicChip"/>
            </HBox>
            <!-- Byline: one real photo (the primary contributor, same
                 convention as the card) + every name in text form next
                 to it - reads like a real article's "By ..." line instead
                 of a bare attributes table. -->
            <HBox alignItems="Center" class="knowledgeDetailByline">
              <!-- Backend-flattened scalars, same as the card (see
                   KnowledgeCard.fragment.xml's own comment on why a
                   client-side composite over `contributors` never resolves
                   here). -->
              <Avatar
                displaySize="S"
                src="{knowledge>primaryContributorAvatarSrc}"
                initials="{knowledge>primaryContributorInitials}"
                backgroundColor="{knowledge>primaryContributorColor}"
                class="sapUiSmallMarginEnd"/>
              <VBox>
                <Text text="{view-knowledge>/contributorsLabel}" class="knowledgeDetailBylineAuthor"/>
                <HBox wrap="Wrap" alignItems="Center" class="knowledgeDetailBylineMeta">
                  <ObjectAttribute title="{i18n-knowledge>attrPublished}" text="{path:'knowledge>publishedAt', targetType:'any', formatter:'.formatter.relativeDateTime'}"/>
                  <ObjectAttribute title="{i18n-knowledge>attrUpdated}" text="{path:'knowledge>modifiedAt', targetType:'any', formatter:'.formatter.relativeDateTime'}"/>
                  <HBox alignItems="Center" class="knowledgeCardViewCount">
                    <core:Icon src="sap-icon://show" class="knowledgeCardViewIcon"/>
                    <Text text="{path:'knowledge>viewCount', formatter:'.formatter.viewCountLabel'}"/>
                  </HBox>
                </HBox>
              </VBox>
            </HBox>
          </VBox>
        </uxap:headerContent>

        <uxap:sections>

          <uxap:ObjectPageSection title="{i18n-knowledge>contentTitle}">
            <uxap:subSections>
              <uxap:ObjectPageSubSection>
                <uxap:blocks>
                  <!-- The article as a real reading surface - a distinct card,
                       not text floating directly on the page background. -->
                  <VBox class="knowledgeArticleCard">
                    <Text text="{knowledge>content}" class="knowledgeArticleText"/>
                  </VBox>
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>

          <uxap:ObjectPageSection title="{i18n-knowledge>attachmentsTitle}">
            <uxap:subSections>
              <uxap:ObjectPageSubSection>
                <uxap:blocks>
                  <List
                    items="{knowledge>attachments}"
                    noDataText=" "
                    showSeparators="None"
                    class="sapUiNoContentPadding knowledgeAttachmentGrid">
                    <StandardListItem
                      icon="{path:'knowledge>fileType', formatter:'.formatter.attachmentIcon'}"
                      title="{knowledge>fileName}"
                      description="{path:'knowledge>fileSize', targetType:'any', formatter:'.formatter.fileSize'}"
                      type="Active"
                      press=".onAttachmentPress"
                      class="knowledgeAttachmentTile"/>
                  </List>
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>

          <!-- visible= set imperatively, same reason as statusBadge/topicChip
               above - a section's own visible= is the same class of
               declarative binding that doesn't reliably apply in this
               ObjectPageLayout. -->
          <uxap:ObjectPageSection id="commentsSection" title="{i18n-knowledge>commentsTitle}">
            <uxap:subSections>
              <uxap:ObjectPageSubSection>
                <uxap:blocks>
                  <List id="commentsList" items="{knowledge>comments}" noDataText="{i18n-knowledge>noComments}" showSeparators="None" class="sapUiNoContentPadding">
                    <CustomListItem class="knowledgeCommentCard">
                      <HBox alignItems="Start" class="sapUiTinyMargin">
                        <Avatar
                          displaySize="XS"
                          src="{parts:[{path:'knowledge>author_userID'}, {path:'knowledge>authorAvatarMimeType'}], formatter:'.formatter.avatarSrc'}"
                          initials="{path:'knowledge>authorDisplayName', formatter:'.formatter.initialsFromName'}"
                          backgroundColor="{path:'knowledge>author_userID', formatter:'.formatter.avatarColorFromID'}"
                          class="sapUiTinyMarginEnd"/>
                        <VBox class="knowledgeCommentBody">
                          <HBox justifyContent="SpaceBetween" alignItems="Center">
                            <Text text="{knowledge>authorDisplayName}" class="knowledgeCommentAuthor"/>
                            <Text text="{path:'knowledge>createdAt', targetType:'any', formatter:'.formatter.relativeDateTime'}" class="knowledgeCardMeta"/>
                          </HBox>
                          <Text text="{knowledge>content}"/>
                        </VBox>
                      </HBox>
                    </CustomListItem>
                  </List>
                  <HBox class="knowledgeCommentComposer sapUiTinyMarginTop" alignItems="Center">
                    <Input
                      placeholder="{i18n-knowledge>addCommentPlaceholder}"
                      value="{view-knowledge>/newCommentText}"
                      width="100%"
                      class="sapUiTinyMarginEnd"/>
                    <Button text="{i18n-knowledge>send}" type="Emphasized" press=".onSubmitComment"/>
                  </HBox>
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>

          <uxap:ObjectPageSection title="{i18n-knowledge>contributorsTitle}">
            <uxap:subSections>
              <uxap:ObjectPageSubSection>
                <uxap:blocks>
                  <List items="{knowledge>contributors}" noDataText="{i18n-knowledge>noContributors}" showSeparators="None" class="sapUiNoContentPadding knowledgeContributorGrid">
                    <CustomListItem class="knowledgeContributorCard">
                      <HBox alignItems="Center" class="sapUiTinyMargin">
                        <Avatar
                          displaySize="S"
                          src="{parts:[{path:'knowledge>user_userID'}, {path:'knowledge>avatarMimeType'}], formatter:'.formatter.avatarSrc'}"
                          initials="{path:'knowledge>displayName', formatter:'.formatter.initialsFromName'}"
                          backgroundColor="{path:'knowledge>user_userID', formatter:'.formatter.avatarColorFromID'}"
                          class="sapUiSmallMarginEnd"/>
                        <VBox>
                          <Text text="{knowledge>displayName}" class="knowledgeContributorName"/>
                          <Text text="{path:'knowledge>role', formatter:'.formatter.contributorRoleLabel'}" class="knowledgeContributorRole"/>
                        </VBox>
                      </HBox>
                    </CustomListItem>
                  </List>
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>

          <uxap:ObjectPageSection title="{i18n-knowledge>relatedDocsTitle}" visible="{view-knowledge>/hasRelatedItems}">
            <uxap:subSections>
              <uxap:ObjectPageSubSection>
                <uxap:blocks>
                  <List items="{view-knowledge>/relatedItems}" noDataText=" " showSeparators="None" class="sapUiNoContentPadding">
                    <StandardListItem type="Navigation" icon="sap-icon://document-text" title="{view-knowledge>title}" press=".onRelatedItemPress"/>
                  </List>
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>

        </uxap:sections>
      </uxap:ObjectPageLayout>
      </VBox>
    </content>
  </Page>
</mvc:View>
