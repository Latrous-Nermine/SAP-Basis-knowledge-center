<mvc:View
  controllerName="aymax.hub.controller.knowledge.KnowledgeList"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <Page title="{i18n-knowledge>pageTitle}" showNavButton="false">
    <headerContent>
      <Button icon="sap-icon://home" type="Transparent" tooltip="{i18n-knowledge>backToFeed}" press=".onHomePress"/>
    </headerContent>
    <content>
      <!-- Centered, max-width reading column with comfortable margins -
           per Fiori Horizon guidance, not a full-bleed layout. -->
      <VBox class="knowledgeContentContainer">

        <VBox class="knowledgeStickyFilters">
          <!-- Interns are blocked server-side (@restrict on CREATE) - there is
               no Profile/People service yet to know the caller's role here, so
               this button stays enabled for everyone; onContribute shows the
               real 403 if it happens. TODO-INTEGRATION.md I-16. -->
          <Toolbar>
            <ToolbarSpacer/>
            <Button
              text="{i18n-knowledge>contribute}"
              type="Emphasized"
              press=".onContribute"/>
          </Toolbar>

          <SearchField
            placeholder="{i18n-knowledge>searchPlaceholder}"
            liveChange=".onSearch"
            class="sapUiSmallMarginTop sapUiSmallMarginBottom"/>

          <HBox wrap="Wrap" items="{view-knowledge>/categoryTabs}">
            <Button
              text="{view-knowledge>label}"
              type="{path:'view-knowledge>active', formatter:'.formatter.tabButtonType'}"
              press=".onCategoryTabPress"
              class="knowledgeCategoryChip sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
          </HBox>
        </VBox>

        <!-- MY KNOWLEDGE - author or contributor, any status. Sub-filters
             (All/Approved/Pending/Draft) are client-side, same Filter
             pattern the category tabs above already use. -->
        <VBox class="knowledgeSection">
          <Title text="{i18n-knowledge>myKnowledgeTitle}" level="H3" class="sapUiSmallMarginBottom"/>
          <HBox wrap="Wrap" items="{view-knowledge>/myKnowledgeStatusTabs}" class="sapUiSmallMarginBottom">
            <Button
              text="{view-knowledge>label}"
              type="{path:'view-knowledge>active', formatter:'.formatter.tabButtonType'}"
              press=".onMyKnowledgeStatusPress"
              class="knowledgeCategoryChip sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
          </HBox>
          <List
            id="myKnowledgeList"
            items="{ path: 'knowledge>/KnowledgeItems', parameters: { $expand: 'contributors' }, sorter: { path: 'createdAt', descending: true } }"
            noDataText="{i18n-knowledge>noMyKnowledgeItems}"
            showSeparators="None"
            class="sapUiNoContentPadding">
            <core:Fragment fragmentName="aymax.hub.view.knowledge.KnowledgeCard" type="XML"/>
          </List>
        </VBox>

        <!-- COMMUNITY KNOWLEDGE - approved only, never anyone else's
             draft/pending/rejected content, never my own items again
             (avoids the confusing "why is my own article also over
             here" duplication). -->
        <VBox class="knowledgeSection sapUiLargeMarginTop">
          <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginBottom">
            <Title text="{i18n-knowledge>communityKnowledgeTitle}" level="H3"/>
            <HBox alignItems="Center">
              <Label text="{i18n-knowledge>sortLabel}" class="sapUiTinyMarginEnd" labelFor="communitySortSelect"/>
              <Select id="communitySortSelect" selectedKey="{view-knowledge>/communitySortKey}" change=".onCommunitySortChange">
                <items>
                  <core:Item key="relevant" text="{i18n-knowledge>sortRelevant}"/>
                  <core:Item key="recent" text="{i18n-knowledge>sortRecent}"/>
                  <core:Item key="upvoted" text="{i18n-knowledge>sortUpvoted}"/>
                </items>
              </Select>
            </HBox>
          </HBox>
          <!-- No client-side `sorter` here (unlike My Knowledge below) -
               ranking is entirely server-side (?sort=, see
               onCommunitySortChange); a client sorter would silently
               re-sort whatever the server returns and undo it. -->
          <List
            id="communityKnowledgeList"
            items="{ path: 'knowledge>/KnowledgeItems', parameters: { $expand: 'contributors' } }"
            noDataText="{i18n-knowledge>noCommunityItems}"
            showSeparators="None"
            class="sapUiNoContentPadding">
            <core:Fragment fragmentName="aymax.hub.view.knowledge.KnowledgeCard" type="XML"/>
          </List>
        </VBox>
      </VBox>
    </content>
  </Page>
</mvc:View>
