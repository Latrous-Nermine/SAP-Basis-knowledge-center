<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">

  <Dialog title="{i18n-excellence>addRecommendationTitle}" contentWidth="28rem">
    <content>
      <VBox class="sapUiContentPadding">

        <Label text="{i18n-excellence>fieldTitle}" required="true"/>
        <Input value="{view-excellence>/newRecommendation/title}" class="sapUiTinyMarginBottom"/>

        <Label text="{i18n-excellence>descriptionLabel}"/>
        <TextArea value="{view-excellence>/newRecommendation/description}" rows="2" width="100%" class="sapUiTinyMarginBottom"/>

        <Label text="{i18n-excellence>reasonLabel}"/>
        <TextArea value="{view-excellence>/newRecommendation/reason}" rows="2" width="100%" class="sapUiTinyMarginBottom"/>

        <Label text="{i18n-excellence>expectedBenefitLabel}"/>
        <TextArea value="{view-excellence>/newRecommendation/expectedBenefit}" rows="2" width="100%" class="sapUiTinyMarginBottom"/>

        <Label text="{i18n-excellence>prioritySelectLabel}"/>
        <Select selectedKey="{view-excellence>/newRecommendation/priority}" class="sapUiTinyMarginBottom" width="100%">
          <core:Item key="high" text="{i18n-excellence>priority.high}"/>
          <core:Item key="medium" text="{i18n-excellence>priority.medium}"/>
          <core:Item key="low" text="{i18n-excellence>priority.low}"/>
        </Select>

        <Label text="{i18n-excellence>attrOwner}"/>
        <Input value="{view-excellence>/newRecommendation/owner}" class="sapUiTinyMarginBottom"/>

        <Label text="{i18n-excellence>targetDateLabel}"/>
        <DatePicker value="{path:'view-excellence>/newRecommendation/targetDate', valueFormat:'yyyy-MM-dd', displayFormat:'medium'}" width="100%"/>

      </VBox>
    </content>
    <buttons>
      <Button text="{i18n-excellence>save}" type="Emphasized" press=".onSaveNewRecommendation"/>
      <Button text="{i18n-excellence>cancel}" press=".onCancelNewRecommendation"/>
    </buttons>
  </Dialog>
</core:FragmentDefinition>
