<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:layout="sap.ui.layout"
  xmlns:core="sap.ui.core">

  <Dialog title="{i18n-validation>editDialogTitle}" contentWidth="500px">
    <content>
      <layout:VerticalLayout width="100%" class="sapUiContentPadding">
        <Label text="{i18n-validation>fieldTitle}" labelFor="editContentTitle" class="sapUiTinyMarginTopBottom"/>
        <Input id="editContentTitle" value="{validation>title}" width="100%"/>
        <Label text="{i18n-validation>fieldExcerpt}" labelFor="editContentExcerpt" class="sapUiTinyMarginTopBottom"/>
        <TextArea id="editContentExcerpt" value="{validation>excerpt}" width="100%" rows="5"/>
      </layout:VerticalLayout>
    </content>
    <beginButton>
      <Button text="{i18n-validation>save}" type="Emphasized" press=".onConfirmModify"/>
    </beginButton>
    <endButton>
      <Button text="{i18n-validation>cancel}" press=".onCancelModify"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>
