<mvc:View
  controllerName="aymax.experts.controller.ExpertsList"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <Page title="{i18n>pageTitle}" showNavButton="false" busy="{view>/busy}" busyIndicatorDelay="0">
    <content>
      <VBox class="expertsContentContainer">

        <VBox class="expertsStickyFilters">
          <Toolbar>
            <ToolbarSpacer/>
            <Button
              text="{i18n>filtersButton}"
              icon="sap-icon://filter"
              press=".onOpenFilters"/>
          </Toolbar>

          <SearchField
            placeholder="{i18n>searchPlaceholder}"
            liveChange=".onSearch"
            class="sapUiSmallMarginTop sapUiSmallMarginBottom"/>

          <HBox wrap="Wrap" items="{view>/departmentFilters}">
            <Button
              text="{view>label}"
              type="{path:'view>active', formatter:'.formatter.departmentFilterButtonType'}"
              press=".onDepartmentFilterPress"
              class="expertsFilterChip sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
          </HBox>

          <HBox wrap="Wrap" visible="{= ${view>/activeFilterTokens}.length > 0 }" class="sapUiTinyMarginBottom">
            <Tokenizer tokens="{path:'view>/activeFilterTokens', templateShareable:'false'}" editable="true" tokenDelete=".onRemoveFilterToken">
              <Token key="{view>key}" text="{view>text}"/>
            </Tokenizer>
          </HBox>
        </VBox>

        <List
          id="expertsList"
          items="{ path: '/People', parameters: { $expand: 'skills,userBadges($expand=badge),technologies' }, sorter: { path: 'reputation', descending: true } }"
          growing="true"
          growingThreshold="20"
          noDataText="{i18n>noExperts}"
          showSeparators="None"
          class="expertsGrid">
          <CustomListItem type="Navigation" press=".onCardPress" class="expertsCard">
            <VBox>
              <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                <Avatar
                  displaySize="L"
                  initials="{path:'displayName', formatter:'.formatter.initials'}"
                  backgroundColor="{path:'userID', formatter:'.formatter.avatarColorFromID'}"
                  class="sapUiSmallMarginEnd"/>
                <VBox class="expertsIdentity">
                  <Title text="{displayName}" level="H5" wrapping="true"/>
                  <Text text="{jobTitle}" class="expertsMeta"/>
                  <Text text="{department}" class="expertsMeta"/>
                </VBox>
              </HBox>

              <HBox wrap="Wrap" items="{path:'technologies', templateShareable:'false'}" class="expertsChipsRow">
                <Text text="{technologyName}" class="expertsTechChip"/>
              </HBox>

              <HBox wrap="Wrap" items="{path:'userBadges', templateShareable:'false'}" class="expertsChipsRow">
                <Text text="{badge/name}" class="expertsBadgeChip"/>
              </HBox>

              <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginTop">
                <ObjectStatus
                  text="{path:'availability', formatter:'.formatter.availabilityLabel'}"
                  state="{path:'availability', formatter:'.formatter.availabilityState'}"/>
                <Text text="{path:'yearsOfExperience', formatter:'.formatter.yearsOfExperienceLabel'}" class="expertsMeta"/>
              </HBox>

              <HBox justifyContent="SpaceBetween" class="expertsCardFooter">
                <Text text="{path:'reputation', formatter:'.formatter.reputationLabel'}"/>
                <Text text="{path:'contributionsCount', formatter:'.formatter.contributionsLabel'}"/>
              </HBox>

              <OverflowToolbar class="sapUiTinyMarginTop expertsCardActions">
                <Button text="{i18n>contact}" icon="sap-icon://email" type="Transparent" press=".onContactPress" tooltip="{i18n>contact}"/>
                <Button
                  text="{path:'isFollowedByMe', formatter:'.formatter.followButtonText'}"
                  icon="{path:'isFollowedByMe', formatter:'.formatter.followButtonIcon'}"
                  type="{path:'isFollowedByMe', formatter:'.formatter.followButtonType'}"
                  visible="{= ${userID} !== ${view>/currentUserID} }"
                  press=".onFollowPress"/>
                <Button text="{i18n>viewProfile}" type="Emphasized" press=".onViewProfilePress"/>
                <Button text="{i18n>askQuestion}" icon="sap-icon://discussion-2" type="Transparent" press=".onAskQuestionPress"/>
              </OverflowToolbar>
            </VBox>
          </CustomListItem>
        </List>
      </VBox>
    </content>
  </Page>
</mvc:View>
