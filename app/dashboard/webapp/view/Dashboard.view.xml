<mvc:View
  controllerName="aymax.dashboard.controller.Dashboard"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:f="sap.f"
  xmlns:card="sap.f.cards"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <Page showNavButton="false" busy="{view>/busy}" busyIndicatorDelay="0">
    <content>
      <VBox class="dashboardContentContainer">

        <Toolbar class="dashboardHeaderToolbar" height="auto">
          <VBox class="dashboardGap4">
            <Title text="{view>/title}" level="H2"/>
            <Text text="{view>/subtitle}" class="dashboardSubtitle"/>
          </VBox>
          <ToolbarSpacer/>
          <Button text="{i18n>refresh}" icon="sap-icon://refresh" press=".onRefresh" tooltip="{i18n>refresh}"/>
        </Toolbar>

        <!-- KPI row - one shared, role-agnostic block. The controller
             normalises each role's differently-shaped scalar fields into
             one uniform {label,value,unit,isFirst} array (view>/kpis)
             after getDashboard() resolves, so this markup never changes
             per role - see Dashboard.controller.js#_buildKpis.

             HBox with flex:1 1 0 tiles (.dashboardKpiTile), NOT
             GridContainer: every other row on this page uses this exact
             primitive, which by flexbox definition always fills the full
             row width - GridContainer's fixed-size auto-fill tiles do
             not, and were leaving 260-540px of dead space on the right
             depending on how many KPIs a role has, the single biggest
             cause of rows not sharing the same right boundary. -->
        <HBox class="dashboardKpiGrid dashboardGap16" wrap="Wrap" width="100%" items="{view>/kpis}">
          <f:Card class="dashboardKpiCard dashboardKpiTile {= ${view>isFirst} ? 'dashboardKpiCardEmphasized' : '' }">
            <f:layoutData>
              <FlexItemData growFactor="1" shrinkFactor="1" baseSize="200px" maxWidth="280px"/>
            </f:layoutData>
            <f:header>
              <card:NumericHeader title="{view>label}" number="{view>value}" unitOfMeasurement="{view>unit}" iconSrc="{view>icon}" iconVisible="true"/>
            </f:header>
          </f:Card>
        </HBox>

        <MessageStrip
          visible="{= ${view>/role} === 'Intern' }"
          type="Information"
          showIcon="true"
          class="sapUiSmallMarginTop"
          text="{i18n>internBanner}"/>

        <core:Fragment fragmentName="aymax.dashboard.view.fragments.EmployeeDashboard" type="XML"/>
        <core:Fragment fragmentName="aymax.dashboard.view.fragments.ManagerDashboard" type="XML"/>
        <core:Fragment fragmentName="aymax.dashboard.view.fragments.HRDashboard" type="XML"/>
        <core:Fragment fragmentName="aymax.dashboard.view.fragments.AdminDashboard" type="XML"/>
        <core:Fragment fragmentName="aymax.dashboard.view.fragments.InternDashboard" type="XML"/>

      </VBox>
    </content>
  </Page>
</mvc:View>
