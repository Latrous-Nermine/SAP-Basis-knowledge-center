<mvc:View
  controllerName="aymax.rewards.controller.Rewards"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:layout="sap.ui.layout"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <Page showHeader="false" class="aymaxPage">
    <content>
      <VBox class="sapUiContentPadding aymaxPageContent">

        <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiMediumMarginBottom">
          <VBox>
            <Title text="Catalogue de récompenses" level="H1" class="aymaxPageTitle"/>
            <Text text="Les employés convertissent leurs points de réputation en cadeaux." class="aymaxMeta sapUiTinyMarginTop"/>
          </VBox>
          <Button text="+ Ajouter une récompense" type="Emphasized" press=".onAddReward"/>
        </HBox>

        <!-- REWARDS GRID -->
        <HBox items="{/Rewards}" wrap="Wrap" class="aymaxRewardGrid">
          <Panel class="aymaxCard aymaxRewardCard sapUiSmallMarginEnd sapUiSmallMarginBottom" width="280px">
            <VBox alignItems="Center" justifyContent="Center" class="sapUiMediumMargin">
              
              <VBox class="aymaxRewardIconWrapper sapUiSmallMarginBottom" alignItems="Center" justifyContent="Center">
                <core:Icon src="sap-icon://gift" size="1.8rem" color="var(--aymax-primary)"/>
              </VBox>
              
              <Title text="{name}" level="H4" class="aymaxRewardTitle sapUiTinyMarginBottom" textAlign="Center"/>
<Text text="{path: 'points', formatter: '.formatPointsLabel'}" class="aymaxRewardPoints sapUiMediumMarginBottom"/>
              
              <Button text="Modifier" type="Default" width="100%" press=".onEditReward" class="aymaxBtnSecondary"/>
              
            </VBox>
          </Panel>
        </HBox>

      </VBox>
    </content>
  </Page>
</mvc:View>
