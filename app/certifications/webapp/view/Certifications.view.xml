<mvc:View
  controllerName="aymax.certifications.controller.Certifications"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:layout="sap.ui.layout"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <Page showHeader="false" class="aymaxPage">
    <content>
      <VBox class="sapUiContentPadding aymaxPageContent">

        <!-- Page Title -->
        <Title text="Certifications" level="H1" class="aymaxPageTitle sapUiMediumMarginBottom"/>

        <!-- ═══════ SECTION: OBTENUES ═══════ -->
        <VBox class="sapUiLargeMarginBottom">
          <Title text="Obtenues" level="H3" class="aymaxSectionTitle sapUiSmallMarginBottom"/>

          <List items="{path: '/Earned', parameters: { $expand: 'certification($expand=tags)' }}" showSeparators="None" class="aymaxCertList">
            <CustomListItem class="aymaxCard sapUiSmallMarginBottom">
              <VBox class="sapUiSmallMargin aymaxCertCardInner">
                <HBox justifyContent="SpaceBetween" alignItems="Start" class="sapUiTinyMarginBottom">
                  <Title text="{certification/name}" level="H4" class="aymaxCertName"/>
                  <core:Icon src="sap-icon://accept" color="#16a34a" size="1.2rem" class="aymaxCheckIcon"/>
                </HBox>
                <Text text="{certification/description}" class="aymaxMeta sapUiTinyMarginBottom" wrapping="true"/>
                <Text text="{earnedDate}" class="aymaxCertDate"/>
                <HBox items="{certification/tags}" wrap="Wrap" class="sapUiSmallMarginTop"><items><Text text="{tag}" class="aymaxTag aymaxTagAccent"/></items></HBox>
              </VBox>
            </CustomListItem>
          </List>
        </VBox>

        <!-- ═══════ SECTION: EN COURS ═══════ -->
        <VBox class="sapUiLargeMarginBottom">
          <Title text="En cours" level="H3" class="aymaxSectionTitle sapUiSmallMarginBottom"/>

          <List items="{path: '/InProgress', parameters: { $expand: 'certification($expand=tags)' }}" showSeparators="None" class="aymaxCertList">
            <CustomListItem class="aymaxCard sapUiSmallMarginBottom">
              <VBox class="sapUiSmallMargin aymaxCertCardInner">
                <HBox justifyContent="SpaceBetween" alignItems="Start" class="sapUiTinyMarginBottom">
                  <Title text="{certification/name}" level="H4" class="aymaxCertName"/>
                  <ObjectStatus text="En cours" state="Information" inverted="true" class="aymaxStatusBadge"/>
                </HBox>
                <Text text="{certification/description}" class="aymaxMeta sapUiTinyMarginBottom" wrapping="true"/>

                <HBox class="sapUiTinyMarginBottom">
                  <Text text="Organisme : " class="aymaxMeta sapUiTinyMarginEnd"/>
                  <Text text="{certification/provider}" class="aymaxCertMetaValue"/>
                </HBox>
                <HBox class="sapUiTinyMarginBottom">
                  <Text text="Débutée le " class="aymaxMeta sapUiTinyMarginEnd"/>
                  <Text text="{startDate}" class="aymaxCertMetaValue"/>
                </HBox>

                <!-- Progress bar -->
                <VBox class="sapUiSmallMarginTop sapUiTinyMarginBottom">
                  <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                    <Text text="Progression" class="aymaxMeta"/>
                    <Text text="{= ${progress} + '%' }" class="aymaxProgressLabel"/>
                  </HBox>
                  <layout:HorizontalLayout class="aymaxProgressBarOuter">
                    <layout:HorizontalLayout
                      class="aymaxProgressBarInner"
                      width="{= ${progress} + '%' }">
                    </layout:HorizontalLayout>
                  </layout:HorizontalLayout>
                </VBox>

                <!-- Skill tags -->
                <HBox items="{certification/tags}" wrap="Wrap" class="sapUiSmallMarginTop"><items><Text text="{tag}" class="aymaxTag aymaxTagAccent"/></items></HBox>

                <Button
                  text="Continuer"
                  type="Transparent"
                  icon="sap-icon://forward"
                  press=".onContinueCertification"
                  class="sapUiSmallMarginTop aymaxContinueBtn"/>
              </VBox>
            </CustomListItem>
          </List>
        </VBox>

        <!-- ═══════ SECTION: RECOMMANDEES ═══════ -->
        <VBox>
          <Title text="Recommandées pour vous" level="H3" class="aymaxSectionTitle sapUiSmallMarginBottom"/>

          <List items="{path: '/Recommended', parameters: { $expand: 'certification($expand=tags)' }}" showSeparators="None" class="aymaxCertList">
            <CustomListItem class="aymaxCard sapUiSmallMarginBottom">
              <VBox class="sapUiSmallMargin aymaxCertCardInner">
                <Title text="{certification/name}" level="H4" class="aymaxCertName sapUiTinyMarginBottom"/>
                <Text text="{certification/description}" class="aymaxMeta sapUiTinyMarginBottom" wrapping="true"/>

                <VBox class="sapUiTinyMarginBottom">
                  <Text text="{= 'Articles recommandés : ' + ${certification/recArticles} }" class="aymaxMeta"/>
                  <Text text="{= 'Questions liées : ' + ${certification/recQuestions} }" class="aymaxMeta"/>
                </VBox>

                <!-- Skill tags -->
                <HBox items="{certification/tags}" wrap="Wrap" class="sapUiSmallMarginTop sapUiTinyMarginBottom"><items><Text text="{tag}" class="aymaxTag aymaxTagAccent"/></items></HBox>

                <Button
                  text="Commencer"
                  type="Emphasized"
                  press=".onStartCertification"
                  class="sapUiSmallMarginTop aymaxStartBtn"/>
              </VBox>
            </CustomListItem>
          </List>
        </VBox>

      </VBox>
    </content>
  </Page>
</mvc:View>

