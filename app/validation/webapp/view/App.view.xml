<mvc:View
  controllerName="aymax.validation.controller.App"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <VBox fitContainer="true">
    <HBox class="aymaxHeader" alignItems="Center" justifyContent="SpaceBetween">
      
      <HBox alignItems="Center">
        <HBox class="aymaxLogo" alignItems="Center">
          <Avatar displaySize="XS" initials="A" class="sapUiTinyMarginEnd aymaxLogoAvatar"/>
          <VBox>
            <Title text="AYMAX" titleStyle="H5"/>
            <Text text="knowledge hub" class="aymaxLogoSub"/>
          </VBox>
        </HBox>

        <HBox class="aymaxNavLinks sapUiSmallMarginBegin">
          <Button text="Tableau de bord" type="Transparent" press=".onNavTo">
            <customData><core:CustomData key="navKey" value="admin"/></customData>
          </Button>
          <Button text="Fil d'actualité" type="Transparent" press=".onNavTo">
            <customData><core:CustomData key="navKey" value="feed"/></customData>
          </Button>
          <Button text="Questions" type="Transparent" press=".onNavTo">
            <customData><core:CustomData key="navKey" value="questions"/></customData>
          </Button>
          <Button text="Centre de connaissances" type="Transparent" press=".onNavTo" class="aymaxNavActive">
            <customData><core:CustomData key="navKey" value="validation"/></customData>
          </Button>
          <Button text="Rooms" type="Transparent" press=".onNavTo">
            <customData><core:CustomData key="navKey" value="rooms"/></customData>
          </Button>
          <Button text="Utilisateurs" type="Transparent" press=".onNavTo">
            <customData><core:CustomData key="navKey" value="hr"/></customData>
          </Button>
          <Button text="Rapports" type="Transparent" press=".onNavTo">
            <customData><core:CustomData key="navKey" value="rapports"/></customData>
          </Button>
        </HBox>
      </HBox>

      <HBox alignItems="Center">
        <Text text="{view>/userRole}" class="aymaxRoleBadge sapUiTinyMarginEnd"/>
        <SearchField width="260px" placeholder="Rechercher..." search=".onGlobalSearch" class="sapUiSmallMarginEnd"/>
        <Button icon="sap-icon://light-mode" type="Transparent" press=".onToggleTheme" class="sapUiTinyMarginEnd"/>
        <Button icon="sap-icon://bell" type="Transparent" class="sapUiTinyMarginEnd"/>
        <Avatar src="{parts:[{path:'view>/currentUser/avatarUrl'},{path:'view>/currentUser/displayName'}], formatter:'.formatAvatar'}" initials="MJ" displaySize="S"/>
      </HBox>
    </HBox>

    <App id="app" defaultTransitionName="slide"/>
  </VBox>
</mvc:View>
