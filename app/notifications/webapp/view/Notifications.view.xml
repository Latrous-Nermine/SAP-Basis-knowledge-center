<mvc:View
  controllerName="aymax.notifications.controller.Notifications"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:f="sap.f"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <f:DynamicPage id="notificationsPage" headerExpanded="false">

    <f:title>
      <f:DynamicPageTitle>
        <f:heading>
          <HBox alignItems="Center">
            <Title text="{i18n>appTitle}" level="H3"/>
          </HBox>
        </f:heading>
        <f:actions>
          <Button
            icon="sap-icon://home"
            type="Transparent"
            tooltip="{i18n>backToFeed}"
            press=".onHomePress"/>
          <Button
            icon="sap-icon://bell"
            type="Transparent"
            text="{view>/unreadCount}"
            tooltip="{i18n>appTitle}"/>
        </f:actions>
      </f:DynamicPageTitle>
    </f:title>

    <f:content>
      <!-- Design (docs/design/Notifications.md) uses a centered, 760px wide
           reading column, not a full width list. HBox plus justifyContent
           reproduces that with layout properties only, no inline style. -->
      <HBox justifyContent="Center" class="sapUiContentPadding">
        <VBox width="760px" class="sapUiResponsiveMargin">

          <Toolbar>
            <Title text="{i18n>pageTitle}" level="H2"/>
            <ToolbarSpacer/>
            <Button
              text="{i18n>markAllRead}"
              type="Transparent"
              press=".onMarkAllRead"/>
          </Toolbar>

          <List
            id="notificationList"
            items="{ path: '/Notifications', sorter: { path: 'createdAt', descending: true } }"
            growing="true"
            growingThreshold="20"
            noDataText="{i18n>noNotifications}">
            <NotificationListItem
              title="{ parts: [{ path: 'type' }, { path: 'params' }], formatter: '.formatter.notificationText' }"
              description="{ path: 'type', formatter: '.formatter.notificationCategory' }"
              datetime="{ path: 'createdAt', formatter: '.formatter.relativeDateTime' }"
              priority="{ path: 'severity', formatter: '.formatter.notificationPriority' }"
              unread="{= !${isRead} }"
              press=".onNotificationPress"/>
          </List>
        </VBox>
      </HBox>
    </f:content>
  </f:DynamicPage>
</mvc:View>
