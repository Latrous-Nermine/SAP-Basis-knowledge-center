{
  "_version": "1.32.0",
  "sap.app": {
    "id": "aymax.feed",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "title": "AYMAX Knowledge Hub",
    "description": "Centralized SAP Knowledge Management",
    "applicationVersion": { "version": "1.0.0" },
    "dataSources": {
      "feedService": {
        "uri": "/odata/v4/feed/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.f": {},
        "sap.ui.core": {},
        "sap.ui.layout": {}
      }
    },
    "rootView": {
      "viewName": "aymax.feed.view.App",
      "type": "XML",
      "async": true,
      "id": "app"
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "aymax.feed.view",
        "controlId": "app",
        "controlAggregation": "pages",
        "async": true
      },
      "routes": [
        { "pattern": "", "name": "feed", "target": "feed" }
      ],
      "targets": {
        "feed": { "viewName": "Feed", "viewLevel": 1 }
      }
    },
    "models": {
      "": {
        "dataSource": "feedService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": { "bundleName": "aymax.feed.i18n.i18n" }
      },
      "view": { "type": "sap.ui.model.json.JSONModel" }
    }
  }
}