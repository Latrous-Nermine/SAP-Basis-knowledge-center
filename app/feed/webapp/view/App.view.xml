<mvc:View
  controllerName="aymax.feed.controller.App"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <VBox fitContainer="true">
    <HBox class="aymaxHeader" alignItems="Center" justifyContent="SpaceBetween">
      
      <HBox alignItems="Center">
        <HBox class="aymaxLogo" alignItems="Center">
          <Avatar displaySize="XS" initials="A" class="sapUiTinyMarginEnd aymaxLogoAvatar"/>
          <VBox>
            <Title text="AYMAX" titleStyle="H5"/>
            <Text text="knowledge hub" class="aymaxLogoSub"/>
          </VBox>
        </HBox>

        <!-- 2026-09 fix: replaces the flat 17-button row (grown from an
             original 8 to the shell's full 19-destination list during the
             2026-08 polish pass, without ever getting the shell's own
             2026-08 grouping fix) - confirmed live via Playwright at
             1440px: the row overflowed off the right edge of the viewport
             ("Vue d'ensemble" clipped), and .aymaxNavLinks/.aymaxHeader in
             header.css force flex-wrap:nowrap, so it never wrapped either.
             Same 4-group MenuButton pattern as the shared shell's own
             header (app/webapp/view/App.view.xml, 2026-08 navbar
             redesign), same group names/order/contents, so the nav no
             longer visibly "changes" crossing between the two apps -
             exactly the goal the original flat-list expansion was already
             trying to reach. Notifications drops out of the group list
             (the bell icon on the right already covers it, matching the
             shell); Profil moves next to the avatar for the same reason.
             One dedicated press handler per item (App.controller.js) -
             sap.m.Menu/MenuItem has already been confirmed elsewhere in
             this project not to reliably read a bare nested CustomData,
             so onNavTo's generic customData-key lookup isn't reused here;
             it stays in place only for Profil below, which is a plain
             Button. -->
        <HBox class="aymaxNavGroups sapUiSmallMarginBegin" alignItems="Center">

          <MenuButton
            id="navGroupAccueil"
            text="Accueil"
            type="Transparent"
            buttonMode="Split"
            defaultAction=".onNavDashboard"
            class="aymaxNavGroupBtn">
            <menu>
              <Menu>
                <items>
                  <MenuItem text="Fil d'actualité" press=".onNavFeed"/>
                </items>
              </Menu>
            </menu>
          </MenuButton>

          <MenuButton
            id="navGroupKnowledge"
            text="Connaissances"
            type="Transparent"
            class="aymaxNavGroupBtn">
            <menu>
              <Menu>
                <items>
                  <MenuItem text="Centre de connaissances" press=".onNavKnowledge"/>
                  <MenuItem text="Questions" press=".onNavQuestions"/>
                  <MenuItem text="Experts" press=".onNavExperts"/>
                  <MenuItem text="Tags" press=".onNavTags"/>
                  <MenuItem text="Rooms" press=".onNavRooms"/>
                </items>
              </Menu>
            </menu>
          </MenuButton>

          <MenuButton
            id="navGroupLearning"
            text="Formation"
            type="Transparent"
            class="aymaxNavGroupBtn">
            <menu>
              <Menu>
                <items>
                  <MenuItem text="Basis Academy" press=".onNavBasisAcademy"/>
                  <MenuItem text="Certifications" press=".onNavCertifications"/>
                </items>
              </Menu>
            </menu>
          </MenuButton>

          <MenuButton
            id="navGroupCompany"
            text="Entreprise"
            type="Transparent"
            class="aymaxNavGroupBtn">
            <menu>
              <Menu>
                <items>
                  <MenuItem text="Centre d'excellence" press=".onNavExcellenceCenter"/>
                  <MenuItem text="Récompenses" press=".onNavRewards"/>
                  <MenuItem id="navItemHr" text="Ressources humaines" press=".onNavHR"/>
                  <MenuItem id="navItemDepot" text="Dépôt de projet" press=".onNavDepot"/>
                  <MenuItem id="navItemRapportsStage" text="Rapport de stage" press=".onNavRapportsStage"/>
                  <MenuItem text="Vue d'ensemble" press=".onNavReports"/>
                  <MenuItem id="navItemValidation" text="Validation" press=".onNavValidation"/>
                  <MenuItem id="navItemAdmin" text="Administration" press=".onNavAdmin"/>
                </items>
              </Menu>
            </menu>
          </MenuButton>

        </HBox>
      </HBox>

      <HBox alignItems="Center">
        <Text text="{view>/userRole}" class="aymaxRoleBadge sapUiTinyMarginEnd"/>
        <SearchField width="260px" placeholder="Rechercher..." search=".onGlobalSearch" class="sapUiSmallMarginEnd"/>
        <Button icon="sap-icon://light-mode" type="Transparent" press=".onToggleTheme" tooltip="Changer de thème" class="sapUiTinyMarginEnd"/>
        <Button icon="sap-icon://bell" type="Transparent" press=".onNotificationsPress" tooltip="Notifications" class="sapUiTinyMarginEnd"/>
        <Button text="Profil" type="Transparent" press=".onNavTo" class="sapUiTinyMarginEnd">
          <customData><core:CustomData key="navKey" value="profile"/></customData>
        </Button>
        <Avatar src="{parts:[{path:'view>/currentUser/avatarUrl'},{path:'view>/currentUser/displayName'}], formatter:'.formatAvatar'}" displaySize="S"/>
      </HBox>
    </HBox>

    <App id="app" defaultTransitionName="slide"/>
  </VBox>
</mvc:View>