<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:form="sap.ui.layout.form">

  <Dialog id="questionCreateDialog" title="Poser une Question" contentWidth="600px">
    <content>
      <form:SimpleForm editable="true" layout="ColumnLayout">
        <form:content>
          <Label text="Titre de la question" required="true"/>
          <Input value="{view>/questionDialog/title}" placeholder="Ex: Comment intercepter les erreurs OData V4 dans UI5 ?"/>

          <!-- Tags : sélection parmi les tags existants ou saisie libre d'un
               nouveau tag (résolu en ID réel au moment de la publication).
               Le fragment attend son propre modèle par défaut ({/tags},
               {/suggestions}), posé par onCreateQuestion - voir
               model/TagPicker.js. -->
          <Label text="Tags"/>
          <core:Fragment fragmentName="aymax.feed.view.fragments.TagPicker" type="XML"/>

          <Label text="Room associée (Optionnel)"/>
          <Select selectedKey="{view>/questionDialog/roomID}" items="{rooms>/Rooms}">
            <items>
              <core:Item key="{rooms>ID}" text="{rooms>name}"/>
            </items>
          </Select>

          <Label text="Description détaillée" required="true"/>
          <TextArea value="{view>/questionDialog/content}" rows="8" placeholder="Décrivez le problème, le contexte et les étapes pour le reproduire..." width="100%"/>
        </form:content>
      </form:SimpleForm>
    </content>
    <beginButton>
      <Button text="Publier la question" type="Emphasized" press=".onConfirmCreateQuestion"/>
    </beginButton>
    <endButton>
      <Button text="Annuler" press=".onCancelQuestionDialog"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>
