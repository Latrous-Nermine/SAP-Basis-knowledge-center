<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:form="sap.ui.layout.form">

  <Dialog id="tagMergeDialog" title="Fusionner deux Tags (Manager)" contentWidth="450px">
    <content>
      <form:SimpleForm editable="true" layout="ColumnLayout">
        <form:content>
          <Label text="Tag source (à supprimer)" required="true"/>
          <Select id="sourceTagSelect" selectedKey="{view>/mergeDialog/sourceTagID}" items="{tags>/Tags}">
            <items>
              <core:Item key="{tags>ID}" text="{tags>name} ({tags>usageCount} utilisations)"/>
            </items>
          </Select>

          <Label text="Tag cible (qui conserve tout)" required="true"/>
          <Select id="targetTagSelect" selectedKey="{view>/mergeDialog/targetTagID}" items="{tags>/Tags}">
            <items>
              <core:Item key="{tags>ID}" text="{tags>name}"/>
            </items>
          </Select>
        </form:content>
      </form:SimpleForm>
    </content>
    <beginButton>
      <Button text="Fusionner" type="Emphasized" press=".onConfirmMergeTags"/>
    </beginButton>
    <endButton>
      <Button text="Annuler" press=".onCancelMergeDialog"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>
