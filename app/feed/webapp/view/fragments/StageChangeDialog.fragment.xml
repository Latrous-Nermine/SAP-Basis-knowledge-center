<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:form="sap.ui.layout.form">

  <Dialog id="stageChangeDialog" title="Déplacer vers un nouveau Stage" contentWidth="450px">
    <content>
      <form:SimpleForm editable="true" layout="ColumnLayout">
        <form:content>
          <Label text="Nouveau Stage" required="true"/>
          <Select id="stageSelect" selectedKey="{view>/stageDialog/stageID}" items="{rooms>/RoomStages}">
            <items>
              <core:Item key="{rooms>ID}" text="{rooms>name}"/>
            </items>
          </Select>

          <Label text="Note de transition"/>
          <TextArea value="{view>/stageDialog/comment}" rows="3" placeholder="Raison de la transition ou commentaires..."/>
        </form:content>
      </form:SimpleForm>
    </content>
    <beginButton>
      <Button text="Changer de Stage" type="Emphasized" press=".onConfirmStageChange"/>
    </beginButton>
    <endButton>
      <Button text="Annuler" press=".onCancelStageDialog"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>
