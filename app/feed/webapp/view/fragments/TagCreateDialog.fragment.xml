<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:form="sap.ui.layout.form">

  <Dialog id="tagCreateDialog" title="Créer un Tag" contentWidth="400px">
    <content>
      <form:SimpleForm editable="true" layout="ColumnLayout">
        <form:content>
          <Label text="Nom du Tag" required="true"/>
          <Input value="{view>/tagDialog/name}" placeholder="Ex: SAPUI5, CAP, HANA..."/>

          <Label text="Couleur Hex"/>
          <Input value="{view>/tagDialog/color}" placeholder="#1E3A8A"/>

          <Label text="Description"/>
          <TextArea value="{view>/tagDialog/description}" rows="2"/>
        </form:content>
      </form:SimpleForm>
    </content>
    <beginButton>
      <Button text="Créer" type="Emphasized" press=".onConfirmCreateTag"/>
    </beginButton>
    <endButton>
      <Button text="Annuler" press=".onCancelTagDialog"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>
