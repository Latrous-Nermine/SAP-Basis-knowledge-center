<mvc:View
  controllerName="aymax.feed.controller.RoomDetail"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:f="sap.f"
  xmlns:layout="sap.ui.layout"
  displayBlock="true">

  <f:DynamicPage id="roomDetailPage" headerExpanded="true">
    <f:title>
      <f:DynamicPageTitle>
        <f:heading>
          <HBox alignItems="Center">
            <Button icon="sap-icon://nav-back" type="Transparent" press=".onNavBack" class="sapUiSmallMarginEnd"/>
            <Avatar src="{parts:[{path:'view>/room/avatarUrl'},{path:'view>/room/name'}], formatter:'.formatAvatar'}" displaySize="M" class="sapUiSmallMarginEnd"/>
            <VBox>
              <Title text="{view>/room/name}" titleStyle="H3"/>
              <Text text="{view>/room/description}" class="aymaxMeta"/>
            </VBox>
          </HBox>
        </f:heading>
        <f:actions>
          <Token text="{view>/room/category}" class="aymaxTagAccent"/>
          <Text text="{view>/room/memberCount} membres" class="aymaxMeta sapUiSmallMarginBegin"/>
          <Button text="Rejoindre" type="Emphasized" press=".onJoinRoom" visible="{= !${view>/room/isFollowed}}"/>
          <Button text="Quitter" type="Transparent" press=".onLeaveRoom" visible="{view>/room/isFollowed}"/>
        </f:actions>
      </f:DynamicPageTitle>
    </f:title>

    <f:header>
      <f:DynamicPageHeader>
        <layout:HorizontalLayout allowWrapping="true">
          <VBox class="sapUiMediumMarginEnd">
            <Text text="Créée le {path:'view>/room/createdAt', formatter:'.formatDate'}" class="aymaxMeta"/>
            <Text text="{view>/room/postCount} publications" class="aymaxMeta"/>
          </VBox>
        </layout:HorizontalLayout>
      </f:DynamicPageHeader>
    </f:header>

    <f:content>
      <!-- aymaxDetailPageContent (2026-08 fix): this page's tab bar and
           every tab's content sat directly under the page chrome with no
           width constraint at all, stretching edge to edge next to the
           rest of the app's 1200px-centered, generously-padded pages -
           same fix QuestionDetail already needed for the same reason
           (see that class's own comment in css/style.css). Wraps the
           WHOLE IconTabBar, not just each tab's content VBox, so the
           tab-selector row (Fil d'actualité/Membres/Fichiers) is
           centered along with what's below it, not left full-width on
           its own. -->
      <VBox class="aymaxDetailPageContent">
      <IconTabBar selectedKey="{view>/selectedTab}" select=".onTabSelect">
        <items>
          <!-- ONGLET FIL D'ACTUALITÉ -->
          <IconTabFilter text="Fil d'actualité" key="feed" icon="sap-icon://feed">
            <VBox class="sapUiContentPadding">
              <!-- Champ de publication dans la room -->
              <Panel class="aymaxCard">
                <HBox alignItems="Start">
                  <Avatar src="{parts:[{path:'view>/currentUser/avatarUrl'},{path:'view>/currentUser/displayName'}], formatter:'.formatAvatar'}" displaySize="S" class="sapUiSmallMarginEnd"/>
                  <VBox width="100%">
                    <TextArea value="{view>/postText}" placeholder="Partagez dans cette room..." growing="true" growingMaxLines="4" width="100%"/>
                    <HBox justifyContent="SpaceBetween" class="sapUiSmallMarginTop">
                      <Button icon="sap-icon://attachment" type="Transparent"/>
                      <Button text="Publier" type="Emphasized" press=".onPublishInRoom"/>
                    </HBox>
                  </VBox>
                </HBox>
              </Panel>

              <!-- Posts de la room. items was bound to the unprefixed "/Posts"
                   path, which resolves against this view's DEFAULT model
                   (feedService, /odata/v4/feed) rather than the "rooms"
                   model (/odata/v4/rooms) - found live: the request never
                   even fired (batched with the Members tab's own broken
                   binding below, whose 405 aborted the whole batch). Every
                   child binding in this template needs the same "rooms>"
                   prefix, not just items= - an unprefixed relative binding
                   under a NAMED-model item context does not inherit that
                   name (the exact bug already found and fixed once this
                   session on QuestionDetail's own answers list). -->
              <List id="roomFeedList"
                    items="{path:'rooms>/Posts', templateShareable:'false', parameters:{$expand:'author,tags,stage'}}"
                    growing="true"
                    growingThreshold="10">
                <CustomListItem>
                  <VBox class="aymaxPostCard sapUiMediumMargin">
                    <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                      <Avatar src="{parts:[{path:'rooms>author/avatarUrl'},{path:'rooms>author/displayName'}], formatter:'.formatAvatar'}" displaySize="S" class="sapUiSmallMarginEnd"/>
                      <VBox>
                        <Title text="{rooms>author/displayName}" level="H5"/>
                        <Text text="{path:'rooms>createdAt', formatter:'.formatDate'}" class="aymaxMeta"/>
                      </VBox>
                      <ToolbarSpacer/>
                      <!-- Room Stage (Brouillon -> Revue -> Approuvé -> Publié): the
                           backend pipeline already existed (RoomStages,
                           PostStageHistory, changePostStage) but nothing in this
                           view could ever trigger it - wiring it up here, not
                           inventing it. Badge only shows when the room actually
                           has stages defined (most rooms don't, today). -->
                      <ObjectStatus
                        text="{= ${rooms>stage/name} || 'Sans stage' }"
                        state="None"
                        visible="{= !!${rooms>stage/ID} }"
                        class="sapUiTinyMarginEnd"/>
                      <Button
                        icon="sap-icon://workflow-tasks"
                        type="Transparent"
                        tooltip="Déplacer vers un autre stage"
                        press=".onChangePostStageDialog"
                        visible="{view>/room/hasStages}"/>
                      <Button icon="sap-icon://overflow" type="Transparent"/>
                    </HBox>
                    <Text text="{rooms>content}" class="sapUiSmallMarginBottom" wrapping="true"/>
                    <HBox wrap="Wrap" visible="{= ${rooms>tags}.length > 0}" class="sapUiTinyMarginBottom">
                      <Tokenizer tokens="{path:'rooms>tags', templateShareable:'false'}">
                        <Token text="{rooms>tag/name}" class="aymaxTag"/>
                      </Tokenizer>
                    </HBox>
                    <HBox justifyContent="SpaceBetween" class="aymaxPostActions">
                      <HBox>
                        <ToggleButton text="{rooms>likeCount}" icon="sap-icon://thumb-up" pressed="{rooms>isLikedByMe}" press=".onLikePress"/>
                        <Button text="{rooms>commentCount}" icon="sap-icon://comment" type="Transparent"/>
                        <Button text="{rooms>shareCount}" icon="sap-icon://share-2" type="Transparent" press=".onShare"/>
                      </HBox>
                    </HBox>
                  </VBox>
                </CustomListItem>
              </List>
            </VBox>
          </IconTabFilter>

          <!-- ONGLET MEMBRES -->
          <IconTabFilter text="Membres" key="members" icon="sap-icon://group">
            <VBox class="sapUiContentPadding">
              <List id="membersList"
                    items="{path:'rooms>/RoomMembers', templateShareable:'false'}"
                    growing="true">
                <CustomListItem>
                  <HBox class="aymaxMemberRow sapUiMediumMargin" alignItems="Center">
                    <Avatar src="{parts:[{path:'rooms>userID'},{path:'rooms>userID'}], formatter:'.formatAvatar'}" displaySize="M" class="sapUiSmallMarginEnd"/>
                    <VBox>
                      <Title text="{rooms>userID}" level="H5"/>
                      <Token text="{rooms>role}" class="aymaxTag"/>
                    </VBox>
                    <ToolbarSpacer/>
                    <Text text="{path:'rooms>joinedAt', formatter:'.formatDate'}" class="aymaxMeta"/>
                  </HBox>
                </CustomListItem>
              </List>
            </VBox>
          </IconTabFilter>

          <!-- ONGLET FICHIERS -->
          <IconTabFilter text="Fichiers" key="files" icon="sap-icon://attachment">
            <VBox class="sapUiContentPadding">
              <List id="filesList" showSeparators="None">
                <StandardListItem title="Aucun fichier pour l'instant" description="Les documents partagés dans cette room apparaîtront ici."/>
              </List>
            </VBox>
          </IconTabFilter>
        </items>
      </IconTabBar>
      </VBox>
    </f:content>
  </f:DynamicPage>
</mvc:View>
