<mvc:View
  controllerName="aymax.admin.controller.Admin"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:layout="sap.ui.layout"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <Page showHeader="false" class="aymaxPage">
    <content>
      <VBox class="sapUiContentPadding aymaxPageContent">

        <!-- Page Title Area -->
        <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiMediumMarginBottom">
          <VBox>
            <HBox alignItems="Center" class="sapUiTinyMarginBottom">
              <core:Icon src="sap-icon://action-settings" size="1.2rem" color="var(--aymax-primary)" class="sapUiSmallMarginEnd"/>
              <Title text="Administration technique" level="H1" class="aymaxPageTitle"/>
            </HBox>
            <Text text="Gérez les rôles, permissions et la configuration système de la plateforme." class="aymaxMeta"/>
          </VBox>
          <HBox>
            <Button text="Actualiser" type="Default" icon="sap-icon://refresh" class="aymaxBtnSecondary"/>
          </HBox>
        </HBox>

        <!-- FILTER TABS -->
        <HBox class="sapUiMediumMarginBottom" wrap="Wrap">
          <Button text="Rôles" type="{= ${view>/activeTab} === 'roles' ? 'Emphasized' : 'Default'}" press=".onTabSelect" class="sapUiSmallMarginEnd sapUiSmallMarginBottom aymaxFilterTab">
            <customData>
              <core:CustomData key="tab" value="roles"/>
            </customData>
          </Button>
          <Button text="Permissions" type="{= ${view>/activeTab} === 'permissions' ? 'Emphasized' : 'Default'}" press=".onTabSelect" class="sapUiSmallMarginEnd sapUiSmallMarginBottom aymaxFilterTab">
            <customData>
              <core:CustomData key="tab" value="permissions"/>
            </customData>
          </Button>
          <Button text="Paramètres" type="{= ${view>/activeTab} === 'settings' ? 'Emphasized' : 'Default'}" press=".onTabSelect" class="sapUiSmallMarginEnd sapUiSmallMarginBottom aymaxFilterTab">
            <customData>
              <core:CustomData key="tab" value="settings"/>
            </customData>
          </Button>
          <Button text="Configuration" type="{= ${view>/activeTab} === 'config' ? 'Emphasized' : 'Default'}" press=".onTabSelect" class="sapUiSmallMarginEnd sapUiSmallMarginBottom aymaxFilterTab">
            <customData>
              <core:CustomData key="tab" value="config"/>
            </customData>
          </Button>
        </HBox>

        <!-- TAB: ROLES -->
        <VBox visible="{= ${view>/activeTab} === 'roles'}">
          <Panel class="aymaxCard">
            <headerToolbar>
              <Toolbar style="Clear">
                <Title level="H5" text="Rôles utilisateurs" class="card-kicker"/>
                <ToolbarSpacer/>
                <Button text="+ Nouveau rôle" type="Emphasized" icon="sap-icon://add" press=".onAddRole"/>
              </Toolbar>
            </headerToolbar>
            <Table items="{/Roles}" class="aymaxTable">
              <columns>
                <Column width="25%"><Text text="Rôle"/></Column>
                <Column width="50%"><Text text="Description"/></Column>
                <Column hAlign="End" width="15%"><Text text="Utilisateurs"/></Column>
                <Column hAlign="End" width="10%"><Text text="Actions"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <cells>
                    <HBox alignItems="Center">
                      <Avatar
                        initials="{path: 'name', formatter: '.formatRoleInitials'}"
                        displaySize="XS"
                        class="sapUiTinyMarginEnd aymaxRoleAvatar"/>
                      <Text text="{name}" class="aymaxBoldText"/>
                    </HBox>
                    <Text text="{desc}" class="aymaxMetaText"/>
                    <HBox justifyContent="End" alignItems="Center">
                      <Text text="{count}" class="aymaxCountText sapUiTinyMarginEnd"/>
                      <Text text="utilisateurs" class="aymaxMetaText"/>
                    </HBox>
                    <Button icon="sap-icon://edit" type="Transparent" tooltip="Modifier" press=".onEditRole"/>
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
          </Panel>
        </VBox>

        <!-- TAB: PERMISSIONS -->
        <VBox visible="{= ${view>/activeTab} === 'permissions'}">
          <Panel class="aymaxCard">
            <headerToolbar>
              <Toolbar style="Clear">
                <Title level="H5" text="Matrice des permissions" class="card-kicker"/>
                <ToolbarSpacer/>
                <Text text="✓ = Autorisé   —  = Non autorisé" class="aymaxMeta"/>
              </Toolbar>
            </headerToolbar>
            <Table items="{/Permissions}" class="aymaxTable aymaxPermTable">
              <columns>
                <Column width="30%"><Text text="Permission"/></Column>
                <Column hAlign="Center"><Text text="Admin"/></Column>
                <Column hAlign="Center"><Text text="Manager"/></Column>
                <Column hAlign="Center"><Text text="RH"/></Column>
                <Column hAlign="Center"><Text text="Employé"/></Column>
                <Column hAlign="Center"><Text text="Stagiaire"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <cells>
                    <Text text="{name}" class="aymaxBoldText"/>
                    <HBox justifyContent="Center">
                      <core:Icon
                        src="{path: 'admin', formatter: '.formatPermIcon'}"
                        color="{path: 'admin', formatter: '.formatPermColor'}"
                        size="1rem"/>
                    </HBox>
                    <HBox justifyContent="Center">
                      <core:Icon
                        src="{path: 'manager', formatter: '.formatPermIcon'}"
                        color="{path: 'manager', formatter: '.formatPermColor'}"
                        size="1rem"/>
                    </HBox>
                    <HBox justifyContent="Center">
                      <core:Icon
                        src="{path: 'hr', formatter: '.formatPermIcon'}"
                        color="{path: 'hr', formatter: '.formatPermColor'}"
                        size="1rem"/>
                    </HBox>
                    <HBox justifyContent="Center">
                      <core:Icon
                        src="{path: 'employee', formatter: '.formatPermIcon'}"
                        color="{path: 'employee', formatter: '.formatPermColor'}"
                        size="1rem"/>
                    </HBox>
                    <HBox justifyContent="Center">
                      <core:Icon
                        src="{path: 'intern', formatter: '.formatPermIcon'}"
                        color="{path: 'intern', formatter: '.formatPermColor'}"
                        size="1rem"/>
                    </HBox>
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
          </Panel>
        </VBox>

        <!-- TAB: SETTINGS -->
        <VBox visible="{= ${view>/activeTab} === 'settings'}">
          <Panel class="aymaxCard aymaxSettingsPanel">
            <headerToolbar>
              <Toolbar style="Clear">
                <Title level="H5" text="Paramètres système" class="card-kicker"/>
              </Toolbar>
            </headerToolbar>
            <VBox class="sapUiMediumMargin">
              <Label text="Nom de la plateforme" class="aymaxLabel sapUiTinyMarginBottom"/>
              <Input value="AYMAX Knowledge Hub" class="sapUiSmallMarginBottom"/>

              <Label text="Langue par défaut" class="aymaxLabel sapUiTinyMarginBottom"/>
              <ComboBox selectedKey="fr" class="sapUiSmallMarginBottom">
                <core:Item key="fr" text="Français"/>
                <core:Item key="en" text="English"/>
                <core:Item key="ar" text="العربية"/>
              </ComboBox>

              <Label text="Durée de session (minutes)" class="aymaxLabel sapUiTinyMarginBottom"/>
              <Input value="120" type="Number" class="sapUiMediumMarginBottom"/>

              <Label text="Mode maintenance" class="aymaxLabel sapUiTinyMarginBottom"/>
              <Switch state="false" customTextOn="Actif" customTextOff="Inactif" class="sapUiSmallMarginBottom"/>

              <Button text="Enregistrer les paramètres" type="Emphasized" icon="sap-icon://save" press=".onSaveSettings"/>
            </VBox>
          </Panel>
        </VBox>

        <!-- TAB: CONFIG -->
        <VBox visible="{= ${view>/activeTab} === 'config'}">
          <Panel class="aymaxCard aymaxSettingsPanel">
            <headerToolbar>
              <Toolbar style="Clear">
                <Title level="H5" text="Configuration SAP BTP" class="card-kicker"/>
              </Toolbar>
            </headerToolbar>
            <VBox class="sapUiMediumMargin">
              <Label text="Environnement SAP BTP" class="aymaxLabel sapUiTinyMarginBottom"/>
              <ComboBox selectedKey="prod" class="sapUiSmallMarginBottom">
                <core:Item key="prod" text="Production"/>
                <core:Item key="rec" text="Recette"/>
                <core:Item key="dev" text="Développement"/>
              </ComboBox>

              <Label text="Authentification" class="aymaxLabel sapUiTinyMarginBottom"/>
              <ComboBox selectedKey="ias" class="sapUiSmallMarginBottom">
                <core:Item key="ias" text="SAP IAS / SSO"/>
                <core:Item key="basic" text="Basic Auth (dev uniquement)"/>
              </ComboBox>

              <Label text="Rétention des données (mois)" class="aymaxLabel sapUiTinyMarginBottom"/>
              <Input value="36" type="Number" class="sapUiSmallMarginBottom"/>

              <Label text="Logs activés" class="aymaxLabel sapUiTinyMarginBottom"/>
              <Switch state="true" customTextOn="Oui" customTextOff="Non" class="sapUiMediumMarginBottom"/>

              <Button text="Enregistrer la configuration" type="Emphasized" icon="sap-icon://save" press=".onSaveSettings"/>
            </VBox>
          </Panel>
        </VBox>

      </VBox>
    </content>
  </Page>
</mvc:View>
