<mvc:View
  controllerName="aymax.depot.controller.Depot"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:layout="sap.ui.layout"
  xmlns:u="sap.ui.unified"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <Page showHeader="false" class="aymaxPage">
    <content>
      <VBox class="sapUiContentPadding aymaxPageContent">

        <Title text="Dépôt de livrables projet" level="H1" class="aymaxPageTitle sapUiSmallMarginBottom"/>
        <Text text="Déposez ici vos livrables finaux. Les fichiers seront automatiquement rattachés à votre profil et consultables par votre tuteur et l'administration." class="aymaxMeta sapUiMediumMarginBottom" wrapping="true"/>

        <!-- DROP ZONE -->
        <VBox class="aymaxCard aymaxDropZone sapUiMediumMarginBottom" alignItems="Center" justifyContent="Center">
          <core:Icon src="sap-icon://upload-to-cloud" size="3rem" color="var(--aymax-neutral-400)" class="sapUiSmallMarginBottom"/>
          <Title text="Glissez-déposez vos fichiers ici" level="H3" class="sapUiTinyMarginBottom"/>
          <Text text="ou" class="aymaxMeta sapUiSmallMarginBottom"/>
          
          <u:FileUploader 
            id="fileUploader"
            name="myFileUpload"
            uploadUrl="upload/"
            tooltip="Sélectionner un fichier"
            change=".onUploadChange"
            buttonText="Parcourir les fichiers"
            buttonOnly="true"
            icon="sap-icon://attachment"
            style="Emphasized"
            class="aymaxBrowseBtn"/>
          
          <Text text="Formats acceptés : PDF, ZIP, DOCX, PPTX (Max: 50MB)" class="aymaxMeta sapUiSmallMarginTop"/>
        </VBox>

        <!-- FILE LIST -->
        <Panel class="aymaxCard">
          <headerToolbar>
            <Toolbar style="Clear"><Title level="H5" text="Fichiers déposés"/></Toolbar>
          </headerToolbar>
          <List items="{/DepotFiles}" showSeparators="None" class="aymaxFileList">
            <CustomListItem>
              <HBox justifyContent="SpaceBetween" alignItems="Center" class="aymaxFileItem">
                <HBox alignItems="Center">
                  <core:Icon 
                    src="{path: 'type', formatter: '.formatIcon'}" 
                    size="1.5rem" 
                    color="var(--aymax-primary)" 
                    class="sapUiSmallMarginEnd"/>
                  <VBox>
                    <Text text="{name}" class="aymaxFileName"/>
                    <Text text="{size} · Ajouté {uploadedAt}" class="aymaxMeta"/>
                  </VBox>
                </HBox>
                <Button 
                  icon="sap-icon://delete" 
                  type="Transparent" 
                  press=".onDeleteFile" 
                  tooltip="Supprimer" 
                  class="aymaxDeleteBtn"/>
              </HBox>
            </CustomListItem>
          </List>
        </Panel>

      </VBox>
    </content>
  </Page>
</mvc:View>
