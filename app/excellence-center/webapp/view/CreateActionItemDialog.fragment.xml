<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">

  <Dialog title="{i18n>addActionItemTitle}" contentWidth="26rem">
    <content>
      <VBox class="sapUiContentPadding">

        <Label text="{i18n>fieldTitle}" required="true"/>
        <Input value="{view>/newActionItem/title}" class="sapUiTinyMarginBottom"/>

        <Label text="{i18n>attrOwner}"/>
        <Input value="{view>/newActionItem/owner}" class="sapUiTinyMarginBottom"/>

        <Label text="{i18n>prioritySelectLabel}"/>
        <Select selectedKey="{view>/newActionItem/priority}" class="sapUiTinyMarginBottom" width="100%">
          <core:Item key="high" text="{i18n>priority.high}"/>
          <core:Item key="medium" text="{i18n>priority.medium}"/>
          <core:Item key="low" text="{i18n>priority.low}"/>
        </Select>

        <Label text="{i18n>statusSelectLabel}"/>
        <Select selectedKey="{view>/newActionItem/status}" class="sapUiTinyMarginBottom" width="100%">
          <core:Item key="not_started" text="{i18n>actionStatus.notStarted}"/>
          <core:Item key="in_progress" text="{i18n>actionStatus.inProgress}"/>
        </Select>

        <Label text="{i18n>deadlineLabel}"/>
        <DatePicker value="{path:'view>/newActionItem/deadline', valueFormat:'yyyy-MM-dd', displayFormat:'medium'}" width="100%"/>

      </VBox>
    </content>
    <buttons>
      <Button text="{i18n>save}" type="Emphasized" press=".onSaveNewActionItem"/>
      <Button text="{i18n>cancel}" press=".onCancelNewActionItem"/>
    </buttons>
  </Dialog>
</core:FragmentDefinition>
