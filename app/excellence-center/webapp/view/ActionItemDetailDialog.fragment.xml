<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">

  <Dialog title="{view>/selectedActionItem/ID}" contentWidth="28rem">
    <content>
      <VBox class="sapUiContentPadding">

        <HBox justifyContent="SpaceBetween" alignItems="Center">
          <ObjectStatus
            text="{path:'view>/selectedActionItem/priority', formatter:'.formatter.recommendationPriorityText'}"
            state="{path:'view>/selectedActionItem/priority', formatter:'.formatter.recommendationPriorityState'}"/>
          <ObjectStatus
            text="{path:'view>/selectedActionItem/status', formatter:'.formatter.actionStatusText'}"
            state="{path:'view>/selectedActionItem/status', formatter:'.formatter.actionStatusState'}"/>
        </HBox>

        <Title text="{view>/selectedActionItem/title}" level="H4" wrapping="true" class="sapUiTinyMarginTop"/>
        <ObjectAttribute title="{i18n>attrOwner}" text="{view>/selectedActionItem/owner}" class="sapUiTinyMarginTop"/>
        <ObjectAttribute title="{i18n>deadlineLabel}" text="{path:'view>/selectedActionItem/deadline', formatter:'.formatter.dateMedium'}"/>

        <Title text="{i18n>relatedRecommendationLabel}" level="H5" class="sapUiSmallMarginTop sapUiTinyMarginBottom"
          visible="{= !!${view>/selectedActionItem/relatedRecommendationTitle} }"/>
        <Text text="{view>/selectedActionItem/relatedRecommendationTitle}"
          visible="{= !!${view>/selectedActionItem/relatedRecommendationTitle} }"/>

      </VBox>
    </content>
    <buttons>
      <Button text="{i18n>close}" press=".onCloseActionItemDetail"/>
    </buttons>
  </Dialog>
</core:FragmentDefinition>
