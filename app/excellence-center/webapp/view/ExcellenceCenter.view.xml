<mvc:View
  controllerName="aymax.excellencecenter.controller.ExcellenceCenter"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:f="sap.f"
  xmlns:card="sap.f.cards"
  xmlns:uxap="sap.uxap"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <!-- sap.f.FlexibleColumnLayout needs the same height:100% ancestor chain
       as sap.f.DynamicPage does in Notifications.view.xml - App provides it. -->
  <App>
    <f:FlexibleColumnLayout id="fcl" layout="{view>/fclLayout}">

      <!-- ============================================================
           BEGIN COLUMN - Projects & Phases (Section 9, this step)
           ============================================================ -->
      <f:beginColumnPages>
        <Page title="{i18n>appTitle}" showNavButton="false" class="excellenceSidebarPage">
          <headerContent>
            <Button
              icon="sap-icon://home"
              type="Transparent"
              tooltip="{i18n>backToFeed}"
              press=".onHomePress"/>
          </headerContent>
          <content>
            <List
              id="projectList"
              items="{path: 'excellence>/projects', templateShareable: false}"
              noDataText="{i18n>noProjects}"
              showSeparators="None"
              class="sapUiNoContentPadding">
              <CustomListItem
                type="Active"
                press=".onProjectPress"
                selected="{= ${excellence>ID} === ${view>/selectedProjectID} }"
                class="excellenceProjectCard">
                <VBox>

                  <HBox justifyContent="SpaceBetween" alignItems="Start" width="100%">
                    <VBox>
                      <layoutData>
                        <FlexItemData growFactor="1" shrinkFactor="1" minWidth="0"/>
                      </layoutData>
                      <Title text="{excellence>name}" level="H4" wrapping="true"/>
                      <Text text="{excellence>client}" class="excellenceMetaText sapUiTinyMarginTop"/>
                    </VBox>
                    <core:Icon
                      src="{parts:[{path:'excellence>ID'},{path:'view>/selectedProjectID'}], formatter:'.formatter.expandIcon'}"
                      tooltip="{parts:[{path:'excellence>ID'},{path:'view>/selectedProjectID'}], formatter:'.formatter.expandCollapseTooltip'}"
                      decorative="false"
                      class="excellenceExpandIcon sapUiTinyMarginBegin"/>
                  </HBox>

                  <HBox justifyContent="SpaceBetween" alignItems="Center" width="100%" class="sapUiTinyMarginTop">
                    <ObjectStatus
                      text="{path:'excellence>reviewStatus', formatter:'.formatter.reviewStatusText'}"
                      state="{path:'excellence>reviewStatus', formatter:'.formatter.reviewStatusValueState'}"/>
                    <Text text="{path:'excellence>phases', formatter:'.formatter.reviewProgress'}%" class="excellenceProgressText"/>
                  </HBox>

                  <ProgressIndicator
                    percentValue="{path:'excellence>phases', formatter:'.formatter.reviewProgress'}"
                    displayValue=" "
                    state="{path:'excellence>phases', formatter:'.formatter.reviewProgressState'}"
                    class="sapUiTinyMarginTop excellenceProgressBar"/>

                  <!-- Accordion: only the selected project's phases render
                       expanded - see controller's _selectProject notes. -->
                  <List
                    items="{path: 'excellence>phases', templateShareable: false}"
                    visible="{= ${excellence>ID} === ${view>/selectedProjectID} }"
                    showSeparators="None"
                    class="excellencePhaseList sapUiNoContentPadding sapUiTinyMarginTop">
                    <CustomListItem
                      type="Active"
                      press=".onPhasePress"
                      selected="{= ${excellence>key} === ${view>/selectedPhaseKey} }"
                      class="excellencePhaseRow">
                      <HBox alignItems="Center" width="100%">
                        <ObjectStatus
                          icon="{path:'excellence>state', formatter:'.formatter.phaseStateIcon'}"
                          state="{path:'excellence>state', formatter:'.formatter.phaseStateValueState'}"
                          tooltip="{path:'excellence>state', formatter:'.formatter.phaseStateText'}"/>
                        <Text
                          text="{path:'excellence>key', formatter:'.formatter.phaseName'}"
                          class="sapUiTinyMarginBegin">
                          <layoutData>
                            <FlexItemData growFactor="1" shrinkFactor="1" minWidth="0"/>
                          </layoutData>
                        </Text>
                      </HBox>
                    </CustomListItem>
                  </List>

                </VBox>
              </CustomListItem>
            </List>
          </content>
        </Page>
      </f:beginColumnPages>

      <!-- ============================================================
           MID COLUMN - Workspace. Three mutually-exclusive states:
           1) a project is selected, no phase open -> real Project
              Overview (Section 11, built this step)
           2) a phase is open -> honest placeholder (Section 10's
              per-phase content is not built yet)
           3) nothing selected (e.g. accordion just collapsed) -> empty state
           ============================================================ -->
      <f:midColumnPages>
        <Page title="{i18n>workspaceTitle}" showNavButton="false">
          <content>

            <uxap:ObjectPageLayout
              id="projectOverviewPage"
              visible="{= !!${view>/selectedProjectID} &amp;&amp; !${view>/selectedPhaseKey} &amp;&amp; ${view>/workspaceMode} === 'overview' }"
              showTitleInHeaderContent="true"
              binding="{view>/selectedProject}">

              <uxap:headerTitle>
                <uxap:ObjectPageDynamicHeaderTitle>
                  <uxap:heading>
                    <Title text="{view>name}" wrapping="true"/>
                  </uxap:heading>
                </uxap:ObjectPageDynamicHeaderTitle>
              </uxap:headerTitle>

              <uxap:headerContent>
                <HBox wrap="Wrap" class="excellenceHeaderMeta" alignItems="Center">
                  <ObjectStatus
                    text="{path:'view>reviewStatus', formatter:'.formatter.reviewStatusText'}"
                    state="{path:'view>reviewStatus', formatter:'.formatter.reviewStatusValueState'}"/>
                  <ObjectAttribute title="{i18n>attrClient}" text="{view>client}"/>
                  <ObjectAttribute title="{i18n>attrDepartment}" text="{view>department}"/>
                  <ObjectAttribute title="{i18n>attrProjectManager}" text="{view>projectManager}"/>
                  <ObjectAttribute
                    title="{i18n>attrDates}"
                    text="{parts:[{path:'view>startDate'},{path:'view>endDate'}], formatter:'.formatter.dateRange'}"/>
                </HBox>
              </uxap:headerContent>

              <uxap:sections>

                <!-- Aperçu: review progress + planned-vs-actual (§10/§12) -->
                <uxap:ObjectPageSection title="{i18n>overviewSectionKpis}">
                  <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                      <uxap:blocks>

                        <HBox class="sapUiSmallMarginBottom" width="100%">
                          <f:Card class="excellenceKpiCard">
                            <f:layoutData>
                              <FlexItemData growFactor="1" shrinkFactor="1" baseSize="200px" maxWidth="280px"/>
                            </f:layoutData>
                            <f:header>
                              <card:NumericHeader
                                title="{i18n>kpiReviewProgress}"
                                number="{path:'view>phases', formatter:'.formatter.reviewProgress'}"
                                unitOfMeasurement="%"/>
                            </f:header>
                          </f:Card>
                        </HBox>

                        <Title text="{i18n>plannedVsActualTitle}" level="H5" class="sapUiTinyMarginBottom"/>

                        <VBox class="excellenceComparisonRow sapUiSmallMarginBottom">
                          <Text text="{i18n>metricBudget}" class="excellenceMetaText"/>
                          <HBox class="sapUiTinyMarginTop" wrap="Wrap" width="100%">
                            <VBox>
                              <layoutData>
                                <FlexItemData growFactor="1" shrinkFactor="1" baseSize="0" minWidth="120px"/>
                              </layoutData>
                              <Text text="{i18n>planned}" class="excellenceMetaText"/>
                              <ObjectNumber number="{path:'view>kpis/budgetPlanned', formatter:'.formatter.currency'}"/>
                            </VBox>
                            <VBox>
                              <layoutData>
                                <FlexItemData growFactor="1" shrinkFactor="1" baseSize="0" minWidth="120px"/>
                              </layoutData>
                              <Text text="{i18n>actual}" class="excellenceMetaText"/>
                              <ObjectNumber
                                number="{path:'view>kpis/budgetActual', formatter:'.formatter.currency'}"
                                state="{parts:[{path:'view>kpis/budgetPlanned'},{path:'view>kpis/budgetActual'}], formatter:'.formatter.comparisonState'}"/>
                            </VBox>
                            <VBox>
                              <layoutData>
                                <FlexItemData growFactor="1" shrinkFactor="1" baseSize="0" minWidth="120px"/>
                              </layoutData>
                              <Text text="{i18n>couldHaveBeen}" class="excellenceMetaText"/>
                              <ObjectNumber number="{path:'view>kpis/budgetCouldHaveBeen', formatter:'.formatter.currency'}"/>
                            </VBox>
                          </HBox>
                        </VBox>

                        <VBox class="excellenceComparisonRow">
                          <Text text="{i18n>metricDuration}" class="excellenceMetaText"/>
                          <HBox class="sapUiTinyMarginTop" wrap="Wrap" width="100%">
                            <VBox>
                              <layoutData>
                                <FlexItemData growFactor="1" shrinkFactor="1" baseSize="0" minWidth="120px"/>
                              </layoutData>
                              <Text text="{i18n>planned}" class="excellenceMetaText"/>
                              <ObjectNumber number="{path:'view>kpis/durationPlannedWeeks', formatter:'.formatter.durationWeeks'}"/>
                            </VBox>
                            <VBox>
                              <layoutData>
                                <FlexItemData growFactor="1" shrinkFactor="1" baseSize="0" minWidth="120px"/>
                              </layoutData>
                              <Text text="{i18n>actual}" class="excellenceMetaText"/>
                              <ObjectNumber
                                number="{path:'view>kpis/durationActualWeeks', formatter:'.formatter.durationWeeks'}"
                                state="{parts:[{path:'view>kpis/durationPlannedWeeks'},{path:'view>kpis/durationActualWeeks'}], formatter:'.formatter.comparisonState'}"/>
                            </VBox>
                            <VBox>
                              <layoutData>
                                <FlexItemData growFactor="1" shrinkFactor="1" baseSize="0" minWidth="120px"/>
                              </layoutData>
                              <Text text="{i18n>couldHaveBeen}" class="excellenceMetaText"/>
                              <ObjectNumber number="{path:'view>kpis/durationCouldHaveBeenWeeks', formatter:'.formatter.durationWeeks'}"/>
                            </VBox>
                          </HBox>
                        </VBox>

                      </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                  </uxap:subSections>
                </uxap:ObjectPageSection>

                <!-- Équipe: review team vs original project team (§15 preview) -->
                <uxap:ObjectPageSection title="{i18n>teamSectionTitle}">
                  <uxap:subSections>
                    <uxap:ObjectPageSubSection title="{i18n>reviewTeamTitle}">
                      <uxap:blocks>
                        <List items="{path:'view>reviewTeam', templateShareable: false}" noDataText=" " showSeparators="None" class="sapUiNoContentPadding">
                          <StandardListItem icon="sap-icon://person-placeholder" title="{view>name}" description="{view>role}"/>
                        </List>
                      </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                    <uxap:ObjectPageSubSection title="{i18n>originalTeamTitle}">
                      <uxap:blocks>
                        <List items="{path:'view>originalTeam', templateShareable: false}" noDataText=" " showSeparators="None" class="sapUiNoContentPadding">
                          <StandardListItem icon="sap-icon://person-placeholder" title="{view>name}" description="{view>role}"/>
                        </List>
                      </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                  </uxap:subSections>
                </uxap:ObjectPageSection>

                <!-- Constats principaux - preview only, full Findings UI is Section 13 -->
                <uxap:ObjectPageSection title="{i18n>findingsSectionTitle}">
                  <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                      <uxap:blocks>
                        <List items="{path:'view>findings', templateShareable: false}" noDataText="{i18n>noFindings}" showSeparators="None" class="sapUiNoContentPadding">
                          <StandardListItem
                            icon="sap-icon://alert"
                            title="{view>title}"
                            info="{path:'view>severity', formatter:'.formatter.findingSeverityText'}"
                            infoState="{path:'view>severity', formatter:'.formatter.findingSeverityState'}"/>
                        </List>
                        <Button text="{i18n>viewAllFindings}" type="Transparent" press=".onShowFindings" class="sapUiTinyMarginTop"/>
                      </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                  </uxap:subSections>
                </uxap:ObjectPageSection>

                <!-- Recommandations - preview only, full UI is Section 18 -->
                <uxap:ObjectPageSection title="{i18n>recommendationsSectionTitle}">
                  <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                      <uxap:blocks>
                        <List items="{path:'view>recommendations', templateShareable: false}" noDataText="{i18n>noRecommendations}" showSeparators="None" class="sapUiNoContentPadding">
                          <StandardListItem
                            icon="sap-icon://lightbulb"
                            title="{view>title}"
                            info="{path:'view>priority', formatter:'.formatter.recommendationPriorityText'}"
                            infoState="{path:'view>priority', formatter:'.formatter.recommendationPriorityState'}"/>
                        </List>
                        <Button text="{i18n>viewAllRecommendations}" type="Transparent" press=".onShowRecommendations" class="sapUiTinyMarginTop"/>
                      </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                  </uxap:subSections>
                </uxap:ObjectPageSection>

                <!-- Actions - full UI is Section 19 -->
                <uxap:ObjectPageSection title="{i18n>actionItemsSectionTitle}">
                  <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                      <uxap:blocks>
                        <List items="{path:'view>actionItems', templateShareable: false}" noDataText="{i18n>noActionItems}" showSeparators="None" class="sapUiNoContentPadding">
                          <StandardListItem
                            icon="sap-icon://task"
                            title="{view>title}"
                            description="{view>owner}"
                            info="{path:'view>status', formatter:'.formatter.actionStatusText'}"
                            infoState="{path:'view>status', formatter:'.formatter.actionStatusState'}"/>
                        </List>
                        <Button text="{i18n>viewAllActionItems}" type="Transparent" press=".onShowActionItems" class="sapUiTinyMarginTop"/>
                      </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                  </uxap:subSections>
                </uxap:ObjectPageSection>

                <!-- Leçons apprises - full UI is Section 20 -->
                <uxap:ObjectPageSection title="{i18n>lessonsSectionTitle}">
                  <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                      <uxap:blocks>
                        <List items="{path:'view>lessons', templateShareable: false}" noDataText="{i18n>noLessons}" showSeparators="None" class="sapUiNoContentPadding">
                          <StandardListItem
                            icon="sap-icon://learning-assistant"
                            title="{view>title}"
                            description="{view>appliesTo}"/>
                        </List>
                        <Button text="{i18n>viewAllLessons}" type="Transparent" press=".onShowLessons" class="sapUiTinyMarginTop"/>
                      </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                  </uxap:subSections>
                </uxap:ObjectPageSection>

              </uxap:sections>
            </uxap:ObjectPageLayout>

            <!-- Findings full management (Section 13) - list, filter, view,
                 add. Reached via "Voir tous les constats" in Overview. Plain
                 VBox with its own header row, not a nested Page - a second
                 Page here would stack a second title bar under the mid
                 column's own (same reasoning as Overview/Phase Detail,
                 which are bare ObjectPageLayouts for the same reason). -->
            <VBox
              id="findingsPage"
              visible="{= !!${view>/selectedProjectID} &amp;&amp; !${view>/selectedPhaseKey} &amp;&amp; ${view>/workspaceMode} === 'findings' }"
              binding="{view>/selectedProject}"
              class="sapUiResponsiveContentPadding">

              <HBox justifyContent="SpaceBetween" alignItems="Center" width="100%" class="sapUiSmallMarginBottom">
                <HBox alignItems="Center">
                  <Button icon="sap-icon://nav-back" type="Transparent" tooltip="{i18n>backToOverview}" press=".onBackToOverview"/>
                  <Title text="{i18n>findingsSectionTitle}" level="H4" class="sapUiTinyMarginBegin"/>
                </HBox>
                <Button text="{i18n>addFindingButton}" type="Emphasized" icon="sap-icon://add" press=".onAddFinding"/>
              </HBox>

              <HBox wrap="Wrap" class="sapUiSmallMarginBottom">
                <Select
                  selectedKey="{view>/findingsSeverityFilter}"
                  change=".onFindingsFilterChange"
                  class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
                  width="12rem">
                  <core:Item key="" text="{i18n>allSeverities}"/>
                  <core:Item key="high" text="{i18n>severity.high}"/>
                  <core:Item key="medium" text="{i18n>severity.medium}"/>
                  <core:Item key="low" text="{i18n>severity.low}"/>
                </Select>
                <Select
                  selectedKey="{view>/findingsStatusFilter}"
                  change=".onFindingsFilterChange"
                  class="sapUiTinyMarginBottom"
                  width="12rem">
                  <core:Item key="" text="{i18n>allStatuses}"/>
                  <core:Item key="proposed" text="{i18n>findingStatus.proposed}"/>
                  <core:Item key="validated" text="{i18n>findingStatus.validated}"/>
                  <core:Item key="resolved" text="{i18n>findingStatus.resolved}"/>
                </Select>
              </HBox>

              <List
                id="findingsList"
                items="{path: 'view>findings', templateShareable: false}"
                noDataText="{i18n>noFindingsMatchFilter}"
                showSeparators="None"
                class="sapUiNoContentPadding">
                <StandardListItem
                  type="Active"
                  press=".onFindingPress"
                  icon="sap-icon://alert"
                  title="{view>title}"
                  description="{path:'view>category', formatter:'.formatter.categoryText'}"
                  info="{path:'view>severity', formatter:'.formatter.findingSeverityText'}"
                  infoState="{path:'view>severity', formatter:'.formatter.findingSeverityState'}"/>
              </List>
            </VBox>

            <!-- Recommendations full management (Section 18) - same shape
                 as Findings above. -->
            <VBox
              id="recommendationsPage"
              visible="{= !!${view>/selectedProjectID} &amp;&amp; !${view>/selectedPhaseKey} &amp;&amp; ${view>/workspaceMode} === 'recommendations' }"
              binding="{view>/selectedProject}"
              class="sapUiResponsiveContentPadding">

              <HBox justifyContent="SpaceBetween" alignItems="Center" width="100%" class="sapUiSmallMarginBottom">
                <HBox alignItems="Center">
                  <Button icon="sap-icon://nav-back" type="Transparent" tooltip="{i18n>backToOverview}" press=".onBackToOverview"/>
                  <Title text="{i18n>recommendationsSectionTitle}" level="H4" class="sapUiTinyMarginBegin"/>
                </HBox>
                <Button text="{i18n>addRecommendationButton}" type="Emphasized" icon="sap-icon://add" press=".onAddRecommendation"/>
              </HBox>

              <HBox wrap="Wrap" class="sapUiSmallMarginBottom">
                <Select
                  selectedKey="{view>/recommendationsPriorityFilter}"
                  change=".onRecommendationsFilterChange"
                  class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
                  width="12rem">
                  <core:Item key="" text="{i18n>allPriorities}"/>
                  <core:Item key="high" text="{i18n>priority.high}"/>
                  <core:Item key="medium" text="{i18n>priority.medium}"/>
                  <core:Item key="low" text="{i18n>priority.low}"/>
                </Select>
                <Select
                  selectedKey="{view>/recommendationsStatusFilter}"
                  change=".onRecommendationsFilterChange"
                  class="sapUiTinyMarginBottom"
                  width="12rem">
                  <core:Item key="" text="{i18n>allStatuses}"/>
                  <core:Item key="proposed" text="{i18n>recommendationStatus.proposed}"/>
                  <core:Item key="accepted" text="{i18n>recommendationStatus.accepted}"/>
                  <core:Item key="implemented" text="{i18n>recommendationStatus.implemented}"/>
                </Select>
              </HBox>

              <List
                id="recommendationsList"
                items="{path: 'view>recommendations', templateShareable: false}"
                noDataText="{i18n>noRecommendationsMatchFilter}"
                showSeparators="None"
                class="sapUiNoContentPadding">
                <StandardListItem
                  type="Active"
                  press=".onRecommendationPress"
                  icon="sap-icon://lightbulb"
                  title="{view>title}"
                  description="{view>owner}"
                  info="{path:'view>priority', formatter:'.formatter.recommendationPriorityText'}"
                  infoState="{path:'view>priority', formatter:'.formatter.recommendationPriorityState'}"/>
              </List>
            </VBox>

            <!-- Action Items full management (Section 19) - same shape again. -->
            <VBox
              id="actionItemsPage"
              visible="{= !!${view>/selectedProjectID} &amp;&amp; !${view>/selectedPhaseKey} &amp;&amp; ${view>/workspaceMode} === 'actionItems' }"
              binding="{view>/selectedProject}"
              class="sapUiResponsiveContentPadding">

              <HBox justifyContent="SpaceBetween" alignItems="Center" width="100%" class="sapUiSmallMarginBottom">
                <HBox alignItems="Center">
                  <Button icon="sap-icon://nav-back" type="Transparent" tooltip="{i18n>backToOverview}" press=".onBackToOverview"/>
                  <Title text="{i18n>actionItemsSectionTitle}" level="H4" class="sapUiTinyMarginBegin"/>
                </HBox>
                <Button text="{i18n>addActionItemButton}" type="Emphasized" icon="sap-icon://add" press=".onAddActionItem"/>
              </HBox>

              <HBox wrap="Wrap" class="sapUiSmallMarginBottom">
                <Select
                  selectedKey="{view>/actionItemsStatusFilter}"
                  change=".onActionItemsFilterChange"
                  class="sapUiTinyMarginEnd sapUiTinyMarginBottom"
                  width="12rem">
                  <core:Item key="" text="{i18n>allStatuses}"/>
                  <core:Item key="not_started" text="{i18n>actionStatus.notStarted}"/>
                  <core:Item key="in_progress" text="{i18n>actionStatus.inProgress}"/>
                  <core:Item key="completed" text="{i18n>actionStatus.completed}"/>
                  <core:Item key="blocked" text="{i18n>actionStatus.blocked}"/>
                </Select>
                <Select
                  selectedKey="{view>/actionItemsPriorityFilter}"
                  change=".onActionItemsFilterChange"
                  class="sapUiTinyMarginBottom"
                  width="12rem">
                  <core:Item key="" text="{i18n>allPriorities}"/>
                  <core:Item key="high" text="{i18n>priority.high}"/>
                  <core:Item key="medium" text="{i18n>priority.medium}"/>
                  <core:Item key="low" text="{i18n>priority.low}"/>
                </Select>
              </HBox>

              <List
                id="actionItemsList"
                items="{path: 'view>actionItems', templateShareable: false}"
                noDataText="{i18n>noActionItemsMatchFilter}"
                showSeparators="None"
                class="sapUiNoContentPadding">
                <StandardListItem
                  type="Active"
                  press=".onActionItemPress"
                  icon="sap-icon://task"
                  title="{view>title}"
                  description="{view>owner}"
                  info="{path:'view>status', formatter:'.formatter.actionStatusText'}"
                  infoState="{path:'view>status', formatter:'.formatter.actionStatusState'}"/>
              </List>
            </VBox>

            <!-- Lessons Learned full view (Section 20) - view only, plus
                 Create Knowledge per lesson (frontend-only, see controller). -->
            <VBox
              id="lessonsPage"
              visible="{= !!${view>/selectedProjectID} &amp;&amp; !${view>/selectedPhaseKey} &amp;&amp; ${view>/workspaceMode} === 'lessons' }"
              binding="{view>/selectedProject}"
              class="sapUiResponsiveContentPadding">

              <HBox alignItems="Center" width="100%" class="sapUiSmallMarginBottom">
                <Button icon="sap-icon://nav-back" type="Transparent" tooltip="{i18n>backToOverview}" press=".onBackToOverview"/>
                <Title text="{i18n>lessonsSectionTitle}" level="H4" class="sapUiTinyMarginBegin"/>
              </HBox>

              <List
                items="{path: 'view>lessons', templateShareable: false}"
                noDataText="{i18n>noLessons}"
                showSeparators="None"
                class="sapUiNoContentPadding">
                <StandardListItem
                  type="Active"
                  press=".onLessonPress"
                  icon="sap-icon://learning-assistant"
                  title="{view>title}"
                  description="{view>appliesTo}"/>
              </List>
            </VBox>

            <!-- Phase detail (Section 10 per-phase content + Section 14
                 Discussion + Section 21 Evidence) - one generic template
                 reused for any phase, not 12 hardcoded pages. -->
            <uxap:ObjectPageLayout
              id="phaseDetailPage"
              visible="{= !!${view>/selectedPhaseKey} }"
              showTitleInHeaderContent="true"
              binding="{view>/selectedPhaseDetail}">

              <uxap:headerTitle>
                <uxap:ObjectPageDynamicHeaderTitle>
                  <uxap:heading>
                    <Title text="{path:'view>key', formatter:'.formatter.phaseName'}" wrapping="true"/>
                  </uxap:heading>
                </uxap:ObjectPageDynamicHeaderTitle>
              </uxap:headerTitle>

              <uxap:headerContent>
                <ObjectStatus
                  icon="{path:'view>state', formatter:'.formatter.phaseStateIcon'}"
                  text="{path:'view>state', formatter:'.formatter.phaseStateText'}"
                  state="{path:'view>state', formatter:'.formatter.phaseStateValueState'}"/>
              </uxap:headerContent>

              <uxap:sections>

                <uxap:ObjectPageSection title="{i18n>phaseDetailAnalysisTitle}">
                  <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                      <uxap:blocks>
                        <Text text="{view>analysis}" visible="{= !!${view>analysis} }" class="excellenceArticleText"/>
                        <Text text="{i18n>noAnalysisYet}" visible="{= !${view>analysis} }" class="excellenceMetaText"/>
                      </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                  </uxap:subSections>
                </uxap:ObjectPageSection>

                <uxap:ObjectPageSection title="{i18n>evidenceSectionTitle}">
                  <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                      <uxap:blocks>
                        <List items="{path:'view>evidence', templateShareable: false}" noDataText="{i18n>noEvidence}" showSeparators="None" class="sapUiNoContentPadding">
                          <StandardListItem icon="sap-icon://attachment" title="{view>name}"/>
                        </List>
                      </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                  </uxap:subSections>
                </uxap:ObjectPageSection>

                <uxap:ObjectPageSection title="{i18n>discussionSectionTitle}">
                  <uxap:subSections>
                    <uxap:ObjectPageSubSection>
                      <uxap:blocks>
                        <List items="{path:'view>discussion', templateShareable: false}" noDataText="{i18n>noDiscussion}" showSeparators="None" class="sapUiNoContentPadding">
                          <StandardListItem
                            icon="sap-icon://person-placeholder"
                            title="{view>author}"
                            description="{view>message}"
                            info="{path:'view>timestamp', formatter:'.formatter.relativeDateTime'}"
                            class="excellenceDiscussionCard"/>
                        </List>
                        <HBox class="excellenceDiscussionComposer sapUiTinyMarginTop" alignItems="Center" width="100%">
                          <Input
                            placeholder="{i18n>discussionPlaceholder}"
                            value="{view>/newDiscussionMessage}"
                            class="sapUiTinyMarginEnd">
                            <layoutData>
                              <FlexItemData growFactor="1" shrinkFactor="1" minWidth="0"/>
                            </layoutData>
                          </Input>
                          <Button text="{i18n>send}" type="Emphasized" press=".onSendDiscussionMessage"/>
                        </HBox>
                      </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                  </uxap:subSections>
                </uxap:ObjectPageSection>

              </uxap:sections>
            </uxap:ObjectPageLayout>

            <VBox
              alignItems="Center" justifyContent="Center"
              visible="{= !${view>/selectedProjectID} }"
              class="excellencePlaceholder sapUiLargeMargin">
              <core:Icon src="sap-icon://folder" size="3rem" class="excellencePlaceholderIcon sapUiSmallMarginBottom" decorative="true"/>
              <Title text="{i18n>selectPhaseTitle}" level="H3"/>
              <Text text="{i18n>selectPhaseText}" class="excellenceMetaText sapUiTinyMarginTop" textAlign="Center"/>
            </VBox>

          </content>
        </Page>
      </f:midColumnPages>

      <!-- ============================================================
           END COLUMN - Members (Section 15) & Activity (Section 16).
           Reuses the SAME reviewTeam/originalTeam data Overview's Équipe
           section already shows - one persistent panel, not a duplicated
           dataset. No role-based visibility filtering yet (Section 22
           isn't built - this app has no session/role concept of its own
           to filter by), so every member is shown to every viewer for now.
           ============================================================ -->
      <f:endColumnPages>
        <Page title="{i18n>teamTitle}" showNavButton="false">
          <content>

            <IconTabBar
              visible="{= !!${view>/selectedProjectID} }"
              binding="{view>/selectedProject}"
              expandable="false"
              class="sapUiResponsiveContentPadding">
              <items>

                <IconTabFilter text="{i18n>teamSectionTitle}" key="team">
                  <Title text="{i18n>reviewTeamTitle}" level="H5" class="sapUiTinyMarginBottom"/>
                  <List items="{path:'view>reviewTeam', templateShareable: false}" noDataText=" " showSeparators="None" class="sapUiNoContentPadding">
                    <StandardListItem icon="sap-icon://person-placeholder" title="{view>name}" description="{view>role}"/>
                  </List>
                  <Title text="{i18n>originalTeamTitle}" level="H5" class="sapUiSmallMarginTop sapUiTinyMarginBottom"/>
                  <List items="{path:'view>originalTeam', templateShareable: false}" noDataText=" " showSeparators="None" class="sapUiNoContentPadding">
                    <StandardListItem icon="sap-icon://person-placeholder" title="{view>name}" description="{view>role}"/>
                  </List>
                </IconTabFilter>

                <IconTabFilter text="{i18n>activityTabTitle}" key="activity">
                  <List items="{path:'view>activity', templateShareable: false}" noDataText="{i18n>noActivity}" showSeparators="None" class="sapUiNoContentPadding">
                    <StandardListItem
                      icon="sap-icon://history"
                      title="{view>actor}"
                      description="{view>description}"
                      info="{path:'view>timestamp', formatter:'.formatter.relativeDateTime'}"/>
                  </List>
                </IconTabFilter>

              </items>
            </IconTabBar>

            <VBox
              alignItems="Center" justifyContent="Center"
              visible="{= !${view>/selectedProjectID} }"
              class="excellencePlaceholder sapUiLargeMargin">
              <core:Icon src="sap-icon://group" size="3rem" class="excellencePlaceholderIcon sapUiSmallMarginBottom" decorative="true"/>
              <Title text="{i18n>teamPlaceholderTitle}" level="H3"/>
              <Text text="{i18n>teamPlaceholderText}" class="excellenceMetaText sapUiTinyMarginTop" textAlign="Center"/>
            </VBox>

          </content>
        </Page>
      </f:endColumnPages>

    </f:FlexibleColumnLayout>
  </App>
</mvc:View>
