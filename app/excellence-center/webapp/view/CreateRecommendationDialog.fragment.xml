<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">

  <Dialog title="{i18n>addRecommendationTitle}" contentWidth="28rem">
    <content>
      <VBox class="sapUiContentPadding">

        <Label text="{i18n>fieldTitle}" required="true"/>
        <Input value="{view>/newRecommendation/title}" class="sapUiTinyMarginBottom"/>

        <Label text="{i18n>descriptionLabel}"/>
        <TextArea value="{view>/newRecommendation/description}" rows="2" width="100%" class="sapUiTinyMarginBottom"/>

        <Label text="{i18n>reasonLabel}"/>
        <TextArea value="{view>/newRecommendation/reason}" rows="2" width="100%" class="sapUiTinyMarginBottom"/>

        <Label text="{i18n>expectedBenefitLabel}"/>
        <TextArea value="{view>/newRecommendation/expectedBenefit}" rows="2" width="100%" class="sapUiTinyMarginBottom"/>

        <Label text="{i18n>prioritySelectLabel}"/>
        <Select selectedKey="{view>/newRecommendation/priority}" class="sapUiTinyMarginBottom" width="100%">
          <core:Item key="high" text="{i18n>priority.high}"/>
          <core:Item key="medium" text="{i18n>priority.medium}"/>
          <core:Item key="low" text="{i18n>priority.low}"/>
        </Select>

        <Label text="{i18n>attrOwner}"/>
        <Input value="{view>/newRecommendation/owner}" class="sapUiTinyMarginBottom"/>

        <Label text="{i18n>targetDateLabel}"/>
        <DatePicker value="{path:'view>/newRecommendation/targetDate', valueFormat:'yyyy-MM-dd', displayFormat:'medium'}" width="100%"/>

      </VBox>
    </content>
    <buttons>
      <Button text="{i18n>save}" type="Emphasized" press=".onSaveNewRecommendation"/>
      <Button text="{i18n>cancel}" press=".onCancelNewRecommendation"/>
    </buttons>
  </Dialog>
</core:FragmentDefinition>
