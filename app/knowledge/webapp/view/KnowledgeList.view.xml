<mvc:View
  controllerName="aymax.knowledge.controller.KnowledgeList"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <Page title="{i18n>pageTitle}" showNavButton="false">
    <content>
      <!-- Centered, max-width reading column with comfortable margins -
           per Fiori Horizon guidance, not a full-bleed layout. -->
      <VBox class="knowledgeContentContainer">

        <VBox class="knowledgeStickyFilters">
          <!-- Interns are blocked server-side (@restrict on CREATE) - there is
               no Profile/People service yet to know the caller's role here, so
               this button stays enabled for everyone; onContribute shows the
               real 403 if it happens. TODO-INTEGRATION.md I-16. -->
          <Toolbar>
            <ToolbarSpacer/>
            <Button
              text="{i18n>contribute}"
              type="Emphasized"
              press=".onContribute"/>
          </Toolbar>

          <SearchField
            placeholder="{i18n>searchPlaceholder}"
            liveChange=".onSearch"
            class="sapUiSmallMarginTop sapUiSmallMarginBottom"/>

          <HBox wrap="Wrap" items="{view>/categoryTabs}">
            <Button
              text="{view>label}"
              type="{path:'view>active', formatter:'.formatter.tabButtonType'}"
              press=".onCategoryTabPress"
              class="knowledgeCategoryChip sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
          </HBox>
        </VBox>

        <List
          id="knowledgeList"
          items="{ path: '/KnowledgeItems', parameters: { $expand: 'contributors' }, sorter: { path: 'createdAt', descending: true } }"
          noDataText="{i18n>noItems}"
          showSeparators="None"
          class="sapUiNoContentPadding">
          <CustomListItem type="Navigation" press=".onItemPress" class="knowledgeCard">
            <VBox>
              <HBox justifyContent="SpaceBetween" alignItems="Center">
                <ObjectStatus text="{path:'category', formatter:'.formatter.categoryLabel'}" state="Information"/>
                <ObjectStatus
                  visible="{path:'status', formatter:'.formatter.isNotApproved'}"
                  text="{path:'status', formatter:'.formatter.statusLabel'}"
                  state="{path:'status', formatter:'.formatter.statusState'}"/>
              </HBox>
              <Title text="{title}" wrapping="true" class="sapUiTinyMarginTop"/>
              <Text text="{excerpt}" maxLines="3" class="sapUiTinyMarginTop"/>
              <Text
                text="{parts: [{path:'contributors'}, {path:'createdAt', targetType:'any'}], formatter:'.formatter.metaLine'}"
                class="sapUiTinyMarginTop"/>
            </VBox>
          </CustomListItem>
        </List>
      </VBox>
    </content>
  </Page>
</mvc:View>
