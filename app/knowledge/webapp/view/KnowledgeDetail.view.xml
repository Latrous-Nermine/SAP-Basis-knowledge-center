<mvc:View
  controllerName="aymax.knowledge.controller.KnowledgeDetail"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:uxap="sap.uxap"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <Page showNavButton="true" navButtonPress=".onNavBack">
    <content>

      <uxap:ObjectPageLayout id="knowledgeObjectPage" showTitleInHeaderContent="true">

        <uxap:headerTitle>
          <uxap:ObjectPageDynamicHeaderTitle>
            <uxap:heading>
              <Title text="{title}" wrapping="true"/>
            </uxap:heading>
            <uxap:actions>
              <!-- Submit for review: only action currently implemented. There is
                   no edit form/route in this app yet, so no Edit button is shown
                   here - adding one would be a new feature, not a restyle.
                   ObjectPageLayout keeps this pinned via its own sticky header,
                   replacing the earlier CSS sticky-toolbar hack. -->
              <Button
                text="{i18n>submitForReview}"
                type="Emphasized"
                press=".onSubmitForReview"
                visible="{path:'status', formatter:'.formatter.canSubmitForReview'}"/>
            </uxap:actions>
          </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>

        <uxap:headerContent>
          <HBox wrap="Wrap" class="sapUiSmallGap knowledgeHeaderMeta" alignItems="Center">
            <ObjectStatus text="{path:'category', formatter:'.formatter.categoryLabel'}" state="Information"/>
            <ObjectStatus
              visible="{path:'status', formatter:'.formatter.isNotApproved'}"
              text="{path:'status', formatter:'.formatter.statusLabel'}"
              state="{path:'status', formatter:'.formatter.statusState'}"/>
            <ObjectAttribute title="{i18n>attrAuthor}" text="{view>/contributorsLabel}"/>
            <ObjectAttribute title="{i18n>attrPublished}" text="{path:'publishedAt', formatter:'.formatter.relativeDateTime'}"/>
            <ObjectAttribute title="{i18n>attrUpdated}" text="{path:'modifiedAt', formatter:'.formatter.relativeDateTime'}"/>
          </HBox>
        </uxap:headerContent>

        <uxap:sections>

          <uxap:ObjectPageSection title="{i18n>contentTitle}">
            <uxap:subSections>
              <uxap:ObjectPageSubSection>
                <uxap:blocks>
                  <!-- The article is the PRIMARY content - deliberately the least
                       decorated surface on the page, no card framing, so it reads
                       like a document, not a tile. -->
                  <Text text="{content}" class="knowledgeArticleText"/>
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>

          <uxap:ObjectPageSection title="{i18n>attachmentsTitle}">
            <uxap:subSections>
              <uxap:ObjectPageSubSection>
                <uxap:blocks>
                  <List
                    items="{attachments}"
                    noDataText=" "
                    showSeparators="None"
                    class="knowledgeSidePanel sapUiNoContentPadding">
                    <StandardListItem
                      icon="sap-icon://attachment"
                      title="{fileName}"
                      description="{path:'fileSize', formatter:'.formatter.fileSize'}"
                      type="Active"
                      press=".onAttachmentPress"/>
                  </List>
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>

          <uxap:ObjectPageSection title="{i18n>commentsTitle}" visible="{path:'status', formatter:'.formatter.canShowComments'}">
            <uxap:subSections>
              <uxap:ObjectPageSubSection>
                <uxap:blocks>
                  <List items="{comments}" noDataText="{i18n>noComments}" showSeparators="None" class="sapUiNoContentPadding">
                    <StandardListItem
                      icon="sap-icon://person-placeholder"
                      title="{author_userID}"
                      description="{content}"
                      info="{path:'createdAt', formatter:'.formatter.relativeDateTime'}"
                      class="knowledgeCommentCard"/>
                  </List>
                  <HBox class="knowledgeCommentComposer sapUiTinyMarginTop" alignItems="Center">
                    <Input
                      placeholder="{i18n>addCommentPlaceholder}"
                      value="{view>/newCommentText}"
                      width="100%"
                      class="sapUiTinyMarginEnd"/>
                    <Button text="{i18n>send}" type="Emphasized" press=".onSubmitComment"/>
                  </HBox>
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>

          <uxap:ObjectPageSection title="{i18n>contributorsTitle}">
            <uxap:subSections>
              <uxap:ObjectPageSubSection>
                <uxap:blocks>
                  <List items="{contributors}" noDataText="{i18n>noContributors}" showSeparators="None" class="sapUiNoContentPadding">
                    <StandardListItem
                      icon="sap-icon://person-placeholder"
                      title="{user_userID}"
                      description="{path:'role', formatter:'.formatter.contributorRoleLabel'}"
                      class="knowledgeContributorCard"/>
                  </List>
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>

          <uxap:ObjectPageSection title="{i18n>relatedDocsTitle}" visible="{view>/hasRelatedItems}">
            <uxap:subSections>
              <uxap:ObjectPageSubSection>
                <uxap:blocks>
                  <List items="{view>/relatedItems}" noDataText=" " showSeparators="None" class="sapUiNoContentPadding">
                    <StandardListItem type="Navigation" icon="sap-icon://document-text" title="{view>title}" press=".onRelatedItemPress"/>
                  </List>
                </uxap:blocks>
              </uxap:ObjectPageSubSection>
            </uxap:subSections>
          </uxap:ObjectPageSection>

        </uxap:sections>
      </uxap:ObjectPageLayout>
    </content>
  </Page>
</mvc:View>
