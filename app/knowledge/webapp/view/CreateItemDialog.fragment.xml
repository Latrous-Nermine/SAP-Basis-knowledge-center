<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">

  <Dialog title="{i18n>contribute}" contentWidth="480px">
    <content>
      <VBox class="sapUiContentPadding">
        <Label text="{i18n>fieldTitle}" labelFor="newItemTitle"/>
        <Input id="newItemTitle" value="{view>/newItem/title}" class="sapUiTinyMarginBottom"/>

        <Label text="{i18n>fieldCategory}" labelFor="newItemCategory"/>
        <Select id="newItemCategory" selectedKey="{view>/newItem/category}" class="sapUiTinyMarginBottom">
          <items>
            <core:Item key="article" text="{i18n>category.article}"/>
            <core:Item key="documentation" text="{i18n>category.documentation}"/>
            <core:Item key="report" text="{i18n>category.report}"/>
            <core:Item key="tutorial" text="{i18n>category.tutorial}"/>
            <core:Item key="best_practice" text="{i18n>category.bestPractice}"/>
            <core:Item key="faq" text="{i18n>category.faq}"/>
            <core:Item key="template" text="{i18n>category.template}"/>
          </items>
        </Select>

        <Label text="{i18n>fieldExcerpt}" labelFor="newItemExcerpt"/>
        <Input id="newItemExcerpt" value="{view>/newItem/excerpt}" class="sapUiTinyMarginBottom"/>

        <Label text="{i18n>fieldContent}" labelFor="newItemContent"/>
        <TextArea id="newItemContent" value="{view>/newItem/content}" rows="6" width="100%"/>
      </VBox>
    </content>
    <beginButton>
      <Button text="{i18n>save}" type="Emphasized" press=".onSaveNewItem"/>
    </beginButton>
    <endButton>
      <Button text="{i18n>cancel}" press=".onCancelNewItem"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>
