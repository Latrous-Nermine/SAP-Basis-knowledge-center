{
  "_version": "1.32.0",
  "sap.app": {
    "id": "aymax.knowledge",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": { "version": "1.0.0" },
    "dataSources": {
      "knowledgeService": {
        "uri": "/odata/v4/knowledge/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.f": {},
        "sap.ui.core": {},
        "sap.ui.layout": {},
        "sap.uxap": {}
      }
    },
    "rootView": {
      "viewName": "aymax.knowledge.view.App",
      "type": "XML",
      "async": true,
      "id": "app"
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "aymax.knowledge.view",
        "controlId": "appNavContainer",
        "controlAggregation": "pages",
        "transition": "slide",
        "async": true
      },
      "routes": [
        { "pattern": "", "name": "list", "target": "list" },
        { "pattern": "knowledge/{itemID}", "name": "detail", "target": "detail" }
      ],
      "targets": {
        "list":   { "viewName": "KnowledgeList",   "viewLevel": 1 },
        "detail": { "viewName": "KnowledgeDetail",  "viewLevel": 2 }
      }
    },
    "models": {
      "": {
        "dataSource": "knowledgeService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": { "bundleName": "aymax.knowledge.i18n.i18n" }
      },
      "view": { "type": "sap.ui.model.json.JSONModel" }
    },
    "resources": {
      "css": [
        { "uri": "css/style.css" }
      ]
    }
  }
}
