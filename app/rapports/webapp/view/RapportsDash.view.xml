<mvc:View
  controllerName="aymax.rapports.dash.controller.RapportsDash"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:layout="sap.ui.layout"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <Page showHeader="false" class="aymaxPage">
    <content>
      <VBox class="sapUiContentPadding aymaxPageContent">

        <!-- Page Header -->
        <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiMediumMarginBottom">
          <VBox>
            <Title text="Vue d'ensemble" level="H1" class="aymaxPageTitle"/>
            <Text text="Indicateurs clés de performance du Knowledge Hub — août 2026" class="aymaxMeta sapUiTinyMarginTop"/>
          </VBox>
          <Button text="Exporter" type="Default" icon="sap-icon://download" class="aymaxBtnSecondary"/>
        </HBox>

        <!-- KPIs GRID — use List with CustomListItem -->
        <List
          id="kpiList"
          items="{view>/kpis}"
          showSeparators="None"
          class="aymaxKpiList sapUiMediumMarginBottom">
          <CustomListItem class="aymaxCard sapUiSmallMarginEnd sapUiSmallMarginBottom aymaxKpiCard">
            <VBox class="sapUiSmallMargin">
              <Text text="{view>label}" class="aymaxMeta sapUiTinyMarginBottom"/>
              <Title text="{view>value}" level="H2" class="aymaxKpiValue"/>
              <HBox alignItems="Center" class="sapUiTinyMarginTop">
                <core:Icon
                  src="{path: 'view>state', formatter: '.formatKpiIcon'}"
                  color="{path: 'view>state', formatter: '.formatKpiColor'}"
                  size="0.75rem"
                  class="sapUiTinyMarginEnd"/>
                <Text text="{view>delta}" class="aymaxKpiDelta"/>
              </HBox>
            </VBox>
          </CustomListItem>
        </List>

        <!-- DATA TABLE -->
        <Panel class="aymaxCard">
          <headerToolbar>
            <Toolbar style="Clear">
              <Title level="H5" text="Performance par département" class="card-kicker"/>
              <ToolbarSpacer/>
              <Button icon="sap-icon://sort" type="Transparent" tooltip="Trier" class="sapUiTinyMarginEnd"/>
              <Button icon="sap-icon://filter" type="Transparent" tooltip="Filtrer"/>
            </Toolbar>
          </headerToolbar>
          <Table items="{view>/deptRows}" class="aymaxTable" growing="true" growingThreshold="10">
            <columns>
              <Column width="35%">
                <Text text="Département"/>
              </Column>
              <Column hAlign="End">
                <Text text="Publications"/>
              </Column>
              <Column hAlign="End">
                <Text text="Questions résolues"/>
              </Column>
              <Column hAlign="End">
                <Text text="Réputation moyenne"/>
              </Column>
              <Column hAlign="End" width="120px">
                <Text text="Tendance"/>
              </Column>
            </columns>
            <items>
              <ColumnListItem>
                <cells>
                  <HBox alignItems="Center">
                    <Avatar
                      initials="{path: 'view>dept', formatter: '.formatDeptInitials'}"
                      displaySize="XS"
                      class="sapUiTinyMarginEnd aymaxDeptAvatar"/>
                    <Text text="{view>dept}" class="aymaxDeptName"/>
                  </HBox>
                  <ObjectNumber number="{view>pubs}" class="aymaxTableNumber"/>
                  <ObjectNumber number="{view>solved}" class="aymaxTableNumber"/>
                  <ObjectNumber number="{view>avgRep}" class="aymaxTableNumber aymaxRepNumber"/>
                  <ObjectStatus
                    text="{path: 'view>avgRep', formatter: '.formatTrend'}"
                    state="{path: 'view>avgRep', formatter: '.formatTrendState'}"
                    inverted="false"/>
                </cells>
              </ColumnListItem>
            </items>
          </Table>
        </Panel>

      </VBox>
    </content>
  </Page>
</mvc:View>
